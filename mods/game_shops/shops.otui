PixPaymentWindow < MainWindow
  id: pixPaymentWindow
  size: 320 360
  modal: true
  focusable: true
  !text: tr('PIX Payment')
  @onEscape: self:destroy()

  UIWidget
    id: qrImage
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 20
    image-auto-resize: true

  Label
    id: infoLabel
    anchors.top: qrImage.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    text-align: center

  TextEdit
    id: codeEdit
    anchors.top: infoLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 10
    margin-right: 10
    margin-top: 5
    height: 80
    multiline: true
    read-only: true

  Button
    id: closeButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 10
    width: 80
    @onClick: self:getParent():destroy()

PixSuccessWindow < MainWindow
  size: 300 240
  modal: true
  focusable: true
  !text: tr('Pagamento confirmado')

  UIWidget
    id: successCheckImage
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 16
    size: 48 48
    image-source: /images/ui/check
    image-auto-resize: false

  Button
    id: successOkButton
    !text: tr('Ok')
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 12
    width: 80
    @onClick: self:getParent():destroy()

  Label
    id: successMessage
    anchors.top: successCheckImage.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: successOkButton.top
    margin-top: 12
    margin-left: 15
    margin-right: 15
    margin-bottom: 8
    text-align: center
    text-wrap: true
    !text: tr('Nos próximos 30 segundos o item será enviado.')

ShopCardWidget < UIWidget
  width: 10
  height: 16
  background-color: #0F0C00EE
  border-width: 1
  border-color: #C89620FF

  Label
    id: cardText
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    margin-right: 5
    font: cipsoftFont
    color: #FFD700FF
    text-align: center
    text-wrap: false

