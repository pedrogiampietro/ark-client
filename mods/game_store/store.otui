ShopCategory < Panel
  height: 20
  focusable: true
  background-color: #1b1b1bcc
  border-width: 1
  border-color: #353535

  $focus:
    background-color: #2b2b2bcc
    border-color: #8a8a8a

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-top: 2

StoreTopTab < Button
  height: 22
  width: 90
  checkable: true
  text-align: center

  $checked:
    color: #f1f1f1

CategoryIconSprite < UISprite
  id: categoryItem
  anchors.fill: parent

CategoryIconItem < UIItem
  id: categoryItem
  anchors.fill: parent
  virtual: true

CategoryIconCreature < UICreature
  id: categoryItem
  anchors.fill: parent

MiniPanel < Panel
  text-offset: 0 2
  text-align: top
  image-source: /images/ui/miniwindow
  image-border: 4
  image-border-top: 20
  image-border-bottom: 4
  padding-left: 3
  padding-bottom: 3
  padding-top: 22
  padding-right: 1

OfferWidget < MiniPanel
  focusable: true
  size: 126 122
  border-width: 1
  border-color: #343434
  margin-left: 4
  margin-top: 4
  phantom: false
  @onDoubleClick: modules.game_store.purchaseDouble(self)

  $focus:
    border-color: #c69a3a

  $hover !focus:
    border-color: #7c7c7c

  Label
    id: offerNameHidden
    visible: false

  Label
    id: offerSale
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 1
    margin-left: 1
    width: 40
    height: 14
    background-color: #6f1d1d
    border-width: 1
    border-color: #b73c3c
    color: #ffdf72
    text-align: center
    text: SALE
    visible: false

  Panel
    id: offerTypePanel
    anchors.top: parent.top
    anchors.bottom: next.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-bottom: 3

  Label
    id: offerPrice
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    image-source: /images/ui/item
    image-border: 2
    &baseText: '%s points'
    color: #28db00
    text-align: center
    margin-left: 0
    margin-right: 2

OfferIconItem < UIItem
  id: offerIcon
  size: 34 34
  padding: 1
  anchors.centerIn: parent
  virtual: true
  phantom: true

OfferIconCreature < UICreature
  id: offerIcon
  size: 80 80
  anchors.centerIn: parent
  phantom: true

HistoryLabel < Label
  height: 18
  focusable: true
  background: alpha

  $focus:
    background: #232323

MainWindow
  id: storeWindow
  !text: 'Game Store'
  size: 760 460
  @onEscape: modules.game_store.hide()

  FlatPanel
    id: infoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    width: 172
    height: 54
    margin-top: 4
    padding: 5

    Label
      id: points
      anchors.top: parent.top
      &baseText: 'Balance: %s'
      text-auto-resize: true
      font: terminus-14px-bold
      anchors.horizontalCenter: parent.horizontalCenter

    Button
      id: buyPoints
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 18
      !text: 'Get Points'
      color: #28db00
      @onClick: modules.game_store.buyPoints()

  FlatPanel
    id: filtersPanel
    anchors.top: infoPanel.bottom
    anchors.left: infoPanel.left
    anchors.bottom: historyButton.top
    width: 172
    margin-top: 8
    margin-bottom: 8
    padding: 4

  Label
    id: categoriesLabel
    text: Categories
    anchors.top: filtersPanel.top
    anchors.left: filtersPanel.left
    margin-top: 4
    margin-left: 4

  TextList
    id: categories
    anchors.top: categoriesLabel.bottom
    anchors.left: filtersPanel.left
    anchors.right: filtersPanel.right
    height: 178
    margin-top: 4
    padding: 1
    focusable: false

  Label
    id: searchLabel
    text: Search
    anchors.top: categories.bottom
    anchors.left: filtersPanel.left
    margin-top: 8
    margin-left: 4
    text-align: left
    text-auto-resize: true

  TextEdit
    id: search
    anchors.top: searchLabel.bottom
    anchors.left: filtersPanel.left
    anchors.right: filtersPanel.right
    height: 18
    margin-top: 4
    margin-left: 4
    margin-right: 4
    @onKeyPress: modules.game_store.onSearch()

  Label
    id: sortLabel
    text: Sort
    anchors.top: search.bottom
    anchors.left: filtersPanel.left
    margin-top: 8
    margin-left: 4
    text-align: left
    text-auto-resize: true

  ComboBox
    id: sortCombo
    anchors.top: sortLabel.bottom
    anchors.left: filtersPanel.left
    anchors.right: filtersPanel.right
    height: 18
    margin-top: 4
    margin-left: 4
    margin-right: 4

  CheckBox
    id: onSaleCheck
    !text: 'On Sale'
    anchors.top: sortCombo.bottom
    anchors.left: filtersPanel.left
    margin-top: 8
    margin-left: 4

  FlatPanel
    id: categoryTabs
    anchors.left: infoPanel.right
    anchors.right: parent.right
    anchors.top: parent.top
    height: 26
    margin-left: 8
    margin-top: 4
    layout:
      type: horizontalBox
      spacing: 4

  FlatPanel
    id: topPanel
    anchors.left: categoryTabs.left
    anchors.right: categoryTabs.right
    anchors.top: categoryTabs.bottom
    height: 58
    margin-top: 6
    padding: 5
    image-source: /images/ui/store_large
    image-border: 1

    Panel
      id: categoryItemBg
      width: 40
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      padding: 4

    Label
      id: selectedCategory
      anchors.top: parent.top
      anchors.left: prev.right
      anchors.right: parent.right
      margin-left: 5
      height: 16
      !text: 'Potions'
      font: terminus-14px-bold
      text-offset: 1 -2

    Label
      id: categoryDescription
      anchors.top: prev.bottom
      anchors.left: prev.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      text-auto-resize: true
      text-wrap: true
      color: #ffffff

  ScrollablePanel
    id: offers
    layout:
      type: grid
      cell-size: 126 122
      flow: true
      cell-spacing: 4
    vertical-scrollbar: offersScrollBar
    anchors.top: topPanel.bottom
    anchors.left: topPanel.left
    anchors.right: topPanel.right
    anchors.bottom: categories.bottom
    image-source: /images/ui/panel_flat
    image-border: 1
    padding: 1
    margin-top: 8
    focusable: false

  VerticalScrollBar
    id: offersScrollBar
    anchors.top: offers.top
    anchors.bottom: offers.bottom
    anchors.right: offers.right
    step: 64
    pixels-scroll: true

  TextList
    id: history
    vertical-scrollbar: historyScrollBar
    anchors.top: parent.top
    anchors.bottom: historyButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    margin-bottom: 10
    padding: 2
    focusable: false
    visible: false

  VerticalScrollBar
    id: historyScrollBar
    anchors.top: history.top
    anchors.bottom: history.bottom
    anchors.right: history.right
    step: 50
    pixels-scroll: true
    visible: false

  Button
    id: backButton
    !text: 'Back'
    anchors.left: infoPanel.left
    anchors.bottom: parent.bottom
    width: 82
    @onClick: modules.game_store.hideHistory()
    visible: false

  Button
    id: historyButton
    !text: 'History'
    anchors.left: infoPanel.left
    anchors.right: infoPanel.right
    anchors.bottom: parent.bottom
    height: 20
    @onClick: modules.game_store.showHistory()

  Button
    id: buttonCancel
    !text: 'Close'
    width: 70
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_store.hide()

  Button
    id: purchaseButton
    !text: 'Purchase'
    width: 78
    margin-right: 10
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.purchase()

  Button
    id: giftButton
    !text: 'Gift'
    width: 58
    margin-right: 10
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.gift()
