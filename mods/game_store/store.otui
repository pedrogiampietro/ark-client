ShopCategory < Panel
  height: 38
  focusable: true
  background-color: #0e171b00
  border-width: 0 0 1 0
  border-color: #20323a66

  $focus:
    background-color: #243944cc
    border-color: #4f8aa2

  $hover !focus:
    background-color: #1a2a3288

  Label
    id: name
    anchors.fill: parent
    margin-left: 16
    margin-top: 11
    color: #96acb8
    text-align: left

CategoryIconSprite < UISprite
  id: categoryItem
  anchors.fill: parent

CategoryIconItem < UIItem
  id: categoryItem
  anchors.fill: parent
  virtual: true

CategoryIconCreature < UICreature
  id: categoryItem
  anchors.fill: parent

OfferWidget < Panel
  focusable: true
  size: 146 174
  background-color: #121d22
  border-width: 1
  border-color: #273d47
  margin-left: 6
  margin-top: 6
  phantom: false
  @onDoubleClick: modules.game_store.purchaseDouble(self)

  $focus:
    background-color: #1a2c34
    border-color: #58a9bf

  $hover !focus:
    background-color: #17262d
    border-color: #37616f

  Label
    id: offerNameHidden
    visible: false

  Label
    id: offerSale
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 4
    margin-right: 4
    width: 44
    height: 14
    background-color: #3a1a10
    border-width: 1
    border-color: #c9774f
    color: #ffcfb6
    text-align: center
    text: SALE
    visible: false

  Panel
    id: offerTypePanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 98
    background-color: #0d1519
    border-width: 0 0 1 0
    border-color: #263b44
    margin-top: 2
    margin-left: 2
    margin-right: 2

  Label
    id: offerName
    anchors.top: offerTypePanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    text-align: center
    color: #e6f2f7
    margin-top: 5
    margin-left: 4
    margin-right: 4

  Label
    id: offerMeta
    anchors.top: offerName.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 14
    text-align: center
    color: #91a9b4
    margin-top: 1

  Label
    id: offerPrice
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    &baseText: '%s points'
    color: #9ef0a2
    text-align: center
    font: terminus-14px-bold
    margin-bottom: 5

OfferIconItem < UIItem
  id: offerIcon
  size: 36 36
  padding: 1
  anchors.centerIn: parent
  virtual: true
  phantom: true

OfferIconCreature < UICreature
  id: offerIcon
  size: 68 68
  anchors.centerIn: parent
  phantom: true

HistoryLabel < Label
  height: 24
  focusable: true
  background: alpha
  color: #96acb8
  margin-left: 10

  $focus:
    background: #1f333c
    color: #d3edf8

MainWindow
  id: storeWindow
  !text: 'Game Store'
  size: 940 560
  @onEscape: modules.game_store.hide()

  Panel
    id: backdrop
    anchors.fill: parent
    background-color: #0b1216

  Panel
    id: headerBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 64
    background-color: #132028
    border-width: 0 0 1 0
    border-color: #315463

    Panel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 4
      background-color: #c98f49

    Label
      text: AETHER STORE
      anchors.top: parent.top
      anchors.left: parent.left
      height: 24
      margin-top: 9
      margin-left: 16
      font: terminus-14px-bold
      color: #f0bf7b

    Label
      text: Curated upgrades, mounts and outfits for your journey
      anchors.top: prev.bottom
      anchors.left: parent.left
      height: 14
      margin-left: 16
      margin-top: 1
      color: #8fabb8

    Panel
      id: infoPanel
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 236
      background-color: #16262e
      border-width: 0 0 0 1
      border-color: #315463
      padding: 8

      Label
        text: WALLET
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        text-align: right
        color: #8da7b3
        height: 13

      Label
        id: points
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        &baseText: 'Balance: %s'
        text-auto-resize: false
        text-align: right
        font: terminus-14px-bold
        color: #ecf8ff
        height: 22
        margin-top: 2

      Label
        text: 'Safe payment and instant delivery'
        anchors.top: points.bottom
        anchors.right: parent.right
        height: 14
        margin-top: 1
        color: #6e8895

      Button
        id: buyPoints
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        width: 132
        height: 24
        !text: '+ Buy Coins'
        color: #9ef0a2
        @onClick: modules.game_store.buyPoints()

  Panel
    id: filtersPanel
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.bottom: actionBar.top
    width: 214
    background-color: #101b20
    border-width: 0 1 0 0
    border-color: #27414c

  Label
    id: categoriesLabel
    text: CATALOG
    anchors.top: filtersPanel.top
    anchors.left: filtersPanel.left
    width: 214
    height: 18
    margin-top: 12
    margin-left: 14
    color: #f0bf7b
    font: terminus-14px-bold

  Panel
    anchors.top: categoriesLabel.bottom
    anchors.left: filtersPanel.left
    anchors.right: filtersPanel.right
    height: 38
    margin-top: 6
    margin-left: 10
    margin-right: 10
    background-color: #14242b
    border-width: 1
    border-color: #2b4a57

    Label
      text: Explore by category
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      color: #84a0ad

  TextList
    id: categories
    anchors.top: categoriesLabel.bottom
    anchors.left: filtersPanel.left
    anchors.right: filtersPanel.right
    anchors.bottom: historyButton.top
    margin-top: 50
    margin-left: 10
    margin-right: 10
    margin-bottom: 8
    padding: 1
    focusable: false
    background-color: #0f191e
    border-width: 1
    border-color: #26404a

  Panel
    id: topPanel
    anchors.top: headerBar.bottom
    anchors.left: filtersPanel.right
    anchors.right: parent.right
    height: 114
    background-color: #122229
    border-width: 0 0 1 0
    border-color: #2f515f

    Panel
      id: categoryItemBg
      anchors.left: parent.left
      anchors.top: parent.top
      width: 84
      height: 84
      margin-left: 14
      margin-top: 14
      background-color: #0c1519
      border-width: 1
      border-color: #355968

    Label
      id: selectedCategory
      anchors.left: categoryItemBg.right
      anchors.top: parent.top
      margin-left: 12
      margin-top: 18
      width: 360
      height: 20
      color: #ebf7fe
      font: terminus-14px-bold

    Label
      id: categoryDescription
      anchors.top: selectedCategory.bottom
      anchors.left: selectedCategory.left
      anchors.right: parent.right
      margin-top: 4
      margin-right: 18
      height: 34
      color: #8da7b3
      text-wrap: true

    Label
      id: resultsInfo
      anchors.right: parent.right
      anchors.top: parent.top
      width: 220
      height: 22
      margin-top: 18
      margin-right: 18
      text-align: right
      color: #9ef0a2
      font: terminus-14px-bold

  Panel
    id: filterBar
    anchors.top: topPanel.bottom
    anchors.left: filtersPanel.right
    anchors.right: parent.right
    height: 38
    background-color: #162a33
    border-width: 0 0 1 0
    border-color: #325766

  Label
    id: searchLabel
    text: Search
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: filterBar.left
    width: 50
    height: 14
    margin-left: 14
    color: #8da7b3
    font: terminus-14px-bold
    text-auto-resize: false

  TextEdit
    id: search
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: searchLabel.right
    width: 216
    height: 24
    margin-left: 6
    background-color: #0f191e
    border-width: 1
    border-color: #325766
    color: #e8f5fb
    @onKeyPress: modules.game_store.onSearch()

  Label
    id: sortLabel
    text: Sort
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: search.right
    width: 34
    height: 14
    margin-left: 12
    color: #8da7b3
    font: terminus-14px-bold
    text-auto-resize: false

  ComboBox
    id: sortCombo
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: sortLabel.right
    width: 180
    height: 24
    margin-left: 6
    background-color: #0f191e
    border-width: 1
    border-color: #325766
    color: #e8f5fb

  CheckBox
    id: onSaleCheck
    !text: 'On Sale Only'
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: sortCombo.right
    margin-left: 14
    color: #a7bcc7

  ScrollablePanel
    id: offers
    layout:
      type: grid
      cell-size: 146 174
      flow: true
      cell-spacing: 8
    vertical-scrollbar: offersScrollBar
    anchors.top: filterBar.bottom
    anchors.left: filtersPanel.right
    anchors.right: parent.right
    anchors.bottom: actionBar.top
    background-color: #0d1519
    border-width: 0
    padding: 10
    focusable: false

  VerticalScrollBar
    id: offersScrollBar
    anchors.top: offers.top
    anchors.bottom: offers.bottom
    anchors.right: offers.right
    step: 88
    pixels-scroll: true

  Panel
    id: emptyState
    anchors.top: offers.top
    anchors.left: offers.left
    anchors.right: offers.right
    anchors.bottom: offers.bottom
    visible: false
    background-color: #0c1419cc

    Label
      text: 'No offers match your filters'
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      width: 280
      height: 16
      text-align: center
      color: #9bb2bf

  TextList
    id: history
    vertical-scrollbar: historyScrollBar
    anchors.top: headerBar.bottom
    anchors.bottom: actionBar.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 2
    padding: 8
    focusable: false
    visible: false
    background-color: #0d1519

  VerticalScrollBar
    id: historyScrollBar
    anchors.top: history.top
    anchors.bottom: history.bottom
    anchors.right: history.right
    step: 50
    pixels-scroll: true
    visible: false

  Panel
    id: actionBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 40
    background-color: #132028
    border-width: 1 0 0 0
    border-color: #2f515f

  Button
    id: backButton
    !text: 'Back'
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 96
    height: 32
    margin-left: 4
    margin-bottom: 3
    @onClick: modules.game_store.hideHistory()
    visible: false

  Button
    id: historyButton
    !text: 'History'
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 96
    height: 32
    margin-left: 4
    margin-bottom: 3
    @onClick: modules.game_store.showHistory()

  Button
    id: buttonCancel
    !text: 'Close'
    width: 82
    height: 32
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 4
    margin-bottom: 3
    @onClick: modules.game_store.hide()

  Button
    id: purchaseButton
    !text: 'Purchase'
    width: 100
    height: 32
    margin-right: 7
    margin-bottom: 3
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.purchase()

  Button
    id: giftButton
    !text: 'Gift'
    width: 72
    height: 32
    margin-right: 7
    margin-bottom: 3
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.gift()
