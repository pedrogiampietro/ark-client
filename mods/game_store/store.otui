// ══════════════════════════════════════════════════════════════
//  Game Store — Premium UI  |  Redesign v2
//  Palette:
//    bg-deep    #09091a     panel-surface  #0e0e1e
//    panel-up   #141430     border-subtle  #1e1e3a
//    border-foc #7755cc     accent-purple  #7755cc
//    accent-gold #d4a843    price-green   #50fa7b
//    text-main  #dcdcec     text-muted    #7878a0
//    sale-bg    #35103d     sale-border   #8822aa
// ══════════════════════════════════════════════════════════════

// ── Category row in sidebar ────────────────────────────────────
ShopCategory < Panel
  height: 28
  focusable: true
  background-color: #09091a00
  border-width: 0 0 1 0
  border-color: #1a1a3066

  $focus:
    background-color: #1c1540dd
    border-color: #7755cc

  $hover !focus:
    background-color: #12123099

  Label
    id: name
    anchors.fill: parent
    margin-left: 14
    margin-top: 5
    color: #9898c4
    text-align: left

// ── Category icon types ────────────────────────────────────────
CategoryIconSprite < UISprite
  id: categoryItem
  anchors.fill: parent

CategoryIconItem < UIItem
  id: categoryItem
  anchors.fill: parent
  virtual: true

CategoryIconCreature < UICreature
  id: categoryItem
  anchors.fill: parent

// ── Offer card ─────────────────────────────────────────────────
OfferWidget < Panel
  focusable: true
  size: 140 144
  background-color: #0d0d1e
  border-width: 1
  border-color: #1e1e38
  margin-left: 6
  margin-top: 6
  phantom: false
  @onDoubleClick: modules.game_store.purchaseDouble(self)

  $focus:
    background-color: #180f3a
    border-color: #7755cc

  $hover !focus:
    background-color: #121230
    border-color: #302a5a

  // Hidden label — full title for purchase logic
  Label
    id: offerNameHidden
    visible: false

  // Sale badge — top-right pill
  Label
    id: offerSale
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 5
    margin-right: 5
    width: 36
    height: 13
    background-color: #35103d
    border-width: 1
    border-color: #8822aa
    color: #ffaaff
    text-align: center
    text: SALE
    visible: false

  // Icon display area
  Panel
    id: offerTypePanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 90
    background-color: #090916
    border-width: 0 0 1 0
    border-color: #1a1a32
    margin-top: 2
    margin-left: 2
    margin-right: 2

  // Visible offer name
  Label
    id: offerName
    anchors.top: offerTypePanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: center
    color: #b0aed0
    margin-top: 4
    margin-left: 4
    margin-right: 4

  // Price label
  Label
    id: offerPrice
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    &baseText: '%s points'
    color: #50fa7b
    text-align: center
    font: terminus-14px-bold
    margin-bottom: 4

// ── Offer icon helpers ─────────────────────────────────────────
OfferIconItem < UIItem
  id: offerIcon
  size: 34 34
  padding: 1
  anchors.centerIn: parent
  virtual: true
  phantom: true

OfferIconCreature < UICreature
  id: offerIcon
  size: 80 80
  anchors.centerIn: parent
  phantom: true

// ── History row ────────────────────────────────────────────────
HistoryLabel < Label
  height: 22
  focusable: true
  background: alpha
  color: #9898c0
  margin-left: 4

  $focus:
    background: #1c1a38
    color: #c0a8ff

// ══════════════════════════════════════════════════════════════
//  Main Store Window
// ══════════════════════════════════════════════════════════════
MainWindow
  id: storeWindow
  !text: 'Game Store'
  size: 820 510
  @onEscape: modules.game_store.hide()

  // ─────────────────────────────────────────
  //  LEFT SIDEBAR — Wallet + Filters
  // ─────────────────────────────────────────

  // Wallet card
  Panel
    id: infoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    width: 188
    height: 80
    margin-top: 4
    background-color: #0e0e1e
    border-width: 1
    border-color: #2a1a5a
    padding: 7

    Label
      text: WALLET
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 14
      text-align: center
      color: #d4a843
      font: terminus-14px-bold

    Label
      id: points
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      &baseText: 'Balance: %s'
      text-auto-resize: false
      text-align: center
      font: terminus-14px-bold
      color: #dcdcec
      height: 20
      margin-top: 3

    Button
      id: buyPoints
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 20
      !text: '+ Get Coins'
      color: #50fa7b
      @onClick: modules.game_store.buyPoints()

  // Sidebar filter background (fills from wallet bottom to history button top)
  Panel
    id: filtersPanel
    anchors.top: infoPanel.bottom
    anchors.left: infoPanel.left
    anchors.bottom: historyButton.top
    width: 188
    margin-top: 6
    margin-bottom: 6
    background-color: #0b0b1a
    border-width: 1
    border-color: #18183a

  // "CATEGORIES" section header
  Label
    id: categoriesLabel
    text: CATEGORIES
    anchors.top: filtersPanel.top
    anchors.left: filtersPanel.left
    width: 188
    height: 16
    margin-top: 7
    margin-left: 10
    color: #7755cc
    font: terminus-14px-bold

  // Category list
  TextList
    id: categories
    anchors.top: categoriesLabel.bottom
    anchors.left: filtersPanel.left
    anchors.right: filtersPanel.right
    height: 186
    margin-top: 3
    padding: 0
    focusable: false
    background-color: #09091800

  // "SEARCH" label
  Label
    id: searchLabel
    text: SEARCH
    anchors.top: categories.bottom
    anchors.left: filtersPanel.left
    height: 13
    margin-top: 8
    margin-left: 10
    color: #44446a
    font: terminus-14px-bold

  // Search input
  TextEdit
    id: search
    anchors.top: searchLabel.bottom
    anchors.left: filtersPanel.left
    anchors.right: filtersPanel.right
    height: 18
    margin-top: 3
    margin-left: 5
    margin-right: 5
    @onKeyPress: modules.game_store.onSearch()

  // "SORT" label
  Label
    id: sortLabel
    text: SORT
    anchors.top: search.bottom
    anchors.left: filtersPanel.left
    height: 13
    margin-top: 8
    margin-left: 10
    color: #44446a
    font: terminus-14px-bold

  // Sort combo
  ComboBox
    id: sortCombo
    anchors.top: sortLabel.bottom
    anchors.left: filtersPanel.left
    anchors.right: filtersPanel.right
    height: 18
    margin-top: 3
    margin-left: 5
    margin-right: 5

  // On Sale filter
  CheckBox
    id: onSaleCheck
    !text: 'On Sale'
    anchors.top: sortCombo.bottom
    anchors.left: filtersPanel.left
    margin-top: 10
    margin-left: 8
    color: #7878a0

  // ─────────────────────────────────────────
  //  RIGHT AREA — Category Header + Offers
  // ─────────────────────────────────────────

  // Category header bar
  Panel
    id: topPanel
    anchors.left: infoPanel.right
    anchors.right: parent.right
    anchors.top: parent.top
    height: 80
    margin-top: 4
    margin-left: 8
    background-color: #0e0e1e
    border-width: 1
    border-color: #2a1a5a
    padding: 0

    // Icon column
    Panel
      id: categoryItemBg
      width: 56
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      background-color: #090916
      border-width: 0 1 0 0
      border-color: #1e1e40
      padding: 6

    // Category name
    Label
      id: selectedCategory
      anchors.top: parent.top
      anchors.left: categoryItemBg.right
      anchors.right: parent.right
      margin-left: 12
      margin-right: 10
      margin-top: 10
      height: 20
      font: terminus-14px-bold
      color: #dcdcec

    // Category description
    Label
      id: categoryDescription
      anchors.top: selectedCategory.bottom
      anchors.left: selectedCategory.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-right: 10
      margin-bottom: 6
      text-auto-resize: false
      text-wrap: true
      color: #6868a0

  // Offer cards grid
  ScrollablePanel
    id: offers
    layout:
      type: grid
      cell-size: 140 144
      flow: true
      cell-spacing: 6
    vertical-scrollbar: offersScrollBar
    anchors.top: topPanel.bottom
    anchors.left: topPanel.left
    anchors.right: topPanel.right
    anchors.bottom: categories.bottom
    background-color: #07071600
    border-width: 1
    border-color: #14143a
    padding: 4
    margin-top: 6
    focusable: false

  VerticalScrollBar
    id: offersScrollBar
    anchors.top: offers.top
    anchors.bottom: offers.bottom
    anchors.right: offers.right
    step: 72
    pixels-scroll: true

  // ─────────────────────────────────────────
  //  HISTORY VIEW (hidden by default)
  // ─────────────────────────────────────────
  TextList
    id: history
    vertical-scrollbar: historyScrollBar
    anchors.top: parent.top
    anchors.bottom: historyButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    margin-bottom: 10
    padding: 4
    focusable: false
    visible: false
    background-color: #07071600

  VerticalScrollBar
    id: historyScrollBar
    anchors.top: history.top
    anchors.bottom: history.bottom
    anchors.right: history.right
    step: 50
    pixels-scroll: true
    visible: false

  // ─────────────────────────────────────────
  //  BOTTOM BUTTON BAR
  // ─────────────────────────────────────────

  Button
    id: backButton
    !text: 'Back'
    anchors.left: infoPanel.left
    anchors.bottom: parent.bottom
    width: 90
    @onClick: modules.game_store.hideHistory()
    visible: false

  Button
    id: historyButton
    !text: 'History'
    anchors.left: infoPanel.left
    anchors.right: infoPanel.right
    anchors.bottom: parent.bottom
    height: 20
    @onClick: modules.game_store.showHistory()

  Button
    id: buttonCancel
    !text: 'Close'
    width: 72
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_store.hide()

  Button
    id: purchaseButton
    !text: 'Purchase'
    width: 84
    margin-right: 8
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.purchase()

  Button
    id: giftButton
    !text: 'Gift'
    width: 62
    margin-right: 8
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.gift()
