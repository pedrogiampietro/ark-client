// ══════════════════════════════════════════════════════════════
//  Game Store — Full UI Overhaul
//  Layout: Header | Horizontal Tabs | [Filters | Grid] | Actions
//
//  Palette:
//    deep      #07071566    surface   #0d0d1e    raised    #131328
//    border    #1c1c38      focus     #7755cc    gold      #d4a843
//    green     #50fa7b      muted     #55557a    dim       #38385a
//    sale-bg   #2e0d36      sale-bdr  #8822aa    sale-txt  #e080ff
// ══════════════════════════════════════════════════════════════

// ── Category tab (horizontal nav) ─────────────────────────────
ShopCategory < Panel
  width: 112
  focusable: true
  background-color: #07071500
  border-width: 0 0 3 0
  border-color: #1c1c3800

  $focus:
    background-color: #1e154488
    border-color: #7755cc

  $hover !focus:
    background-color: #10103344

  Label
    id: name
    anchors.fill: parent
    text-align: center
    color: #55557a

// ── Category icon types ────────────────────────────────────────
CategoryIconSprite < UISprite
  id: categoryItem
  anchors.fill: parent

CategoryIconItem < UIItem
  id: categoryItem
  anchors.fill: parent
  virtual: true

CategoryIconCreature < UICreature
  id: categoryItem
  anchors.fill: parent

// ── Offer card ─────────────────────────────────────────────────
OfferWidget < Panel
  focusable: true
  size: 130 150
  background-color: #0d0d1e
  border-width: 1
  border-color: #1c1c38
  margin-left: 4
  margin-top: 4
  phantom: false
  @onDoubleClick: modules.game_store.purchaseDouble(self)

  $focus:
    background-color: #16093a
    border-color: #7755cc

  $hover !focus:
    background-color: #111130
    border-color: #2a2a50

  Label
    id: offerNameHidden
    visible: false

  // Sale pill — top right
  Label
    id: offerSale
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 5
    margin-right: 5
    width: 34
    height: 13
    background-color: #2e0d36
    border-width: 1
    border-color: #8822aa
    color: #e080ff
    text-align: center
    text: SALE
    visible: false

  // Icon/artwork area
  Panel
    id: offerTypePanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 94
    background-color: #08081a
    border-width: 0 0 1 0
    border-color: #181832
    margin-top: 2
    margin-left: 2
    margin-right: 2

  // Item name
  Label
    id: offerName
    anchors.top: offerTypePanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: center
    color: #a8a8cc
    margin-top: 4
    margin-left: 3
    margin-right: 3

  // Price
  Label
    id: offerPrice
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    &baseText: '%s points'
    color: #50fa7b
    text-align: center
    font: terminus-14px-bold
    margin-bottom: 4

// ── Icon helpers ───────────────────────────────────────────────
OfferIconItem < UIItem
  id: offerIcon
  size: 32 32
  padding: 1
  anchors.centerIn: parent
  virtual: true
  phantom: true

OfferIconCreature < UICreature
  id: offerIcon
  size: 64 64
  anchors.centerIn: parent
  phantom: true

// ── History row ────────────────────────────────────────────────
HistoryLabel < Label
  height: 22
  focusable: true
  background: alpha
  color: #8888b0
  margin-left: 6

  $focus:
    background: #1a1838
    color: #c0a8ff

// ══════════════════════════════════════════════════════════════
//  Main Store Window  860 × 530
// ══════════════════════════════════════════════════════════════
MainWindow
  id: storeWindow
  !text: 'Game Store'
  size: 860 530
  @onEscape: modules.game_store.hide()

  // ── HEADER BAR (full width) ──────────────────────────────
  Panel
    id: headerBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 60
    background-color: #0d0d1e
    border-width: 0 0 1 0
    border-color: #2a1860
    padding: 0

    // Store branding
    Label
      text: GAME STORE
      anchors.top: parent.top
      anchors.left: parent.left
      height: 26
      margin-top: 10
      margin-left: 16
      font: terminus-14px-bold
      color: #d4a843

    Label
      text: Browse and purchase exclusive items for your character
      anchors.top: prev.bottom
      anchors.left: parent.left
      height: 14
      margin-top: 2
      margin-left: 16
      color: #38385a

    // Wallet cluster — right side
    Panel
      id: infoPanel
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 196
      border-width: 0 0 0 1
      border-color: #1c1c38
      background-color: #09091a
      padding: 8

      Label
        id: points
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        &baseText: 'Balance: %s'
        text-auto-resize: false
        text-align: right
        font: terminus-14px-bold
        color: #dcdcec
        height: 20

      Button
        id: buyPoints
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        width: 110
        height: 20
        !text: '+ Get Coins'
        color: #50fa7b
        @onClick: modules.game_store.buyPoints()

  // ── CATEGORY TABS (horizontal, full width) ───────────────
  Panel
    id: categories
    layout:
      type: horizontalBox
      fit-children: false
      spacing: 0
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 34
    background-color: #09091a
    border-width: 0 0 1 0
    border-color: #1c1c38
    focusable: false
    padding-left: 6

  // ── FILTER PANEL (left sidebar, below tabs) ──────────────
  Panel
    id: filtersPanel
    anchors.top: categories.bottom
    anchors.left: parent.left
    anchors.bottom: historyButton.top
    width: 156
    background-color: #09091a
    border-width: 0 1 0 0
    border-color: #1c1c38
    padding: 10

    Label
      id: searchLabel
      text: SEARCH
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 13
      margin-top: 4
      color: #38385a
      font: terminus-14px-bold

    TextEdit
      id: search
      anchors.top: searchLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      margin-top: 4
      @onKeyPress: modules.game_store.onSearch()

    Label
      id: sortLabel
      text: SORT BY
      anchors.top: search.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 13
      margin-top: 12
      color: #38385a
      font: terminus-14px-bold

    ComboBox
      id: sortCombo
      anchors.top: sortLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      margin-top: 4

    CheckBox
      id: onSaleCheck
      !text: 'On Sale Only'
      anchors.top: sortCombo.bottom
      anchors.left: parent.left
      margin-top: 14
      color: #7878a0

  // ── OFFER GRID ───────────────────────────────────────────
  ScrollablePanel
    id: offers
    layout:
      type: grid
      cell-size: 130 150
      flow: true
      cell-spacing: 4
    vertical-scrollbar: offersScrollBar
    anchors.top: categories.bottom
    anchors.left: filtersPanel.right
    anchors.right: parent.right
    anchors.bottom: historyButton.top
    background-color: #07071500
    border-width: 0
    padding: 6
    margin-top: 0
    focusable: false

  VerticalScrollBar
    id: offersScrollBar
    anchors.top: offers.top
    anchors.bottom: offers.bottom
    anchors.right: offers.right
    step: 78
    pixels-scroll: true

  // ── HISTORY VIEW (hidden by default) ─────────────────────
  TextList
    id: history
    vertical-scrollbar: historyScrollBar
    anchors.top: headerBar.bottom
    anchors.bottom: historyButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 0
    margin-bottom: 6
    padding: 6
    focusable: false
    visible: false
    background-color: #07071500

  VerticalScrollBar
    id: historyScrollBar
    anchors.top: history.top
    anchors.bottom: history.bottom
    anchors.right: history.right
    step: 50
    pixels-scroll: true
    visible: false

  // ── BOTTOM ACTION BAR ────────────────────────────────────
  Panel
    id: actionBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 28
    background-color: #0a0a1a
    border-width: 1 0 0 0
    border-color: #1c1c38

  Button
    id: backButton
    !text: 'Back'
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 90
    @onClick: modules.game_store.hideHistory()
    visible: false

  Button
    id: historyButton
    !text: 'History'
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 90
    height: 26
    @onClick: modules.game_store.showHistory()

  Button
    id: buttonCancel
    !text: 'Close'
    width: 72
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_store.hide()

  Button
    id: purchaseButton
    !text: 'Purchase'
    width: 84
    margin-right: 8
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.purchase()

  Button
    id: giftButton
    !text: 'Gift'
    width: 62
    margin-right: 8
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.gift()
