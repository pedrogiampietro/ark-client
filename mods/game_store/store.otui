ShopCategory < Panel
  height: 34
  focusable: true
  background-color: #0a0a1a00
  border-width: 0 0 1 0
  border-color: #15153344

  $focus:
    background-color: #23124ecc
    border-color: #3a2874

  $hover !focus:
    background-color: #12123388

  Label
    id: name
    anchors.fill: parent
    margin-left: 16
    margin-top: 9
    color: #60609a
    text-align: left

CategoryIconSprite < UISprite
  id: categoryItem
  anchors.fill: parent

CategoryIconItem < UIItem
  id: categoryItem
  anchors.fill: parent
  virtual: true

CategoryIconCreature < UICreature
  id: categoryItem
  anchors.fill: parent

OfferWidget < Panel
  focusable: true
  size: 132 158
  background-color: #101022
  border-width: 1
  border-color: #1e1e44
  margin-left: 5
  margin-top: 5
  phantom: false
  @onDoubleClick: modules.game_store.purchaseDouble(self)

  $focus:
    background-color: #1b1140
    border-color: #8a63f0

  $hover !focus:
    background-color: #151534
    border-color: #313166

  Label
    id: offerNameHidden
    visible: false

  Label
    id: offerSale
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 4
    margin-right: 4
    width: 40
    height: 14
    background-color: #351144
    border-width: 1
    border-color: #aa39d1
    color: #f39dff
    text-align: center
    text: SALE
    visible: false

  Panel
    id: offerTypePanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 92
    background-color: #090913
    border-width: 0 0 1 0
    border-color: #20204d
    margin-top: 2
    margin-left: 2
    margin-right: 2

  Label
    id: offerName
    anchors.top: offerTypePanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: center
    color: #d6d6ee
    margin-top: 4
    margin-left: 4
    margin-right: 4

  Label
    id: offerMeta
    anchors.top: offerName.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 14
    text-align: center
    color: #6e6ea8
    margin-top: 1

  Label
    id: offerPrice
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    &baseText: '%s points'
    color: #67f1a3
    text-align: center
    font: terminus-14px-bold
    margin-bottom: 5

OfferIconItem < UIItem
  id: offerIcon
  size: 34 34
  padding: 1
  anchors.centerIn: parent
  virtual: true
  phantom: true

OfferIconCreature < UICreature
  id: offerIcon
  size: 64 64
  anchors.centerIn: parent
  phantom: true

HistoryLabel < Label
  height: 24
  focusable: true
  background: alpha
  color: #8e8ec0
  margin-left: 8

  $focus:
    background: #261c52
    color: #dfccff

MainWindow
  id: storeWindow
  !text: 'Game Store'
  size: 900 550
  @onEscape: modules.game_store.hide()

  Panel
    id: backdrop
    anchors.fill: parent
    background-color: #070712

  Panel
    id: headerBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 72
    background-color: #101022
    border-width: 0 0 1 0
    border-color: #2e2160

    Label
      text: GAME STORE
      anchors.top: parent.top
      anchors.left: parent.left
      height: 24
      margin-top: 12
      margin-left: 16
      font: terminus-14px-bold
      color: #f0c86d

    Label
      text: Explore premium content and boost your adventure
      anchors.top: prev.bottom
      anchors.left: parent.left
      height: 14
      margin-left: 16
      margin-top: 3
      color: #5a5a93

    Panel
      id: infoPanel
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 228
      background-color: #0a0a1a
      border-width: 0 0 0 1
      border-color: #1f1f45
      padding: 10

      Label
        text: WALLET
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        text-align: right
        color: #6f6fae
        height: 13

      Label
        id: points
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        &baseText: 'Balance: %s'
        text-auto-resize: false
        text-align: right
        font: terminus-14px-bold
        color: #e4e4f7
        height: 22
        margin-top: 2

      Button
        id: buyPoints
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        width: 126
        height: 22
        !text: '+ Buy Coins'
        color: #67f1a3
        @onClick: modules.game_store.buyPoints()

  Panel
    id: filtersPanel
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.bottom: actionBar.top
    width: 188
    background-color: #0b0b1b
    border-width: 0 1 0 0
    border-color: #1b1b3c

  Label
    id: categoriesLabel
    text: CATEGORIES
    anchors.top: filtersPanel.top
    anchors.left: filtersPanel.left
    width: 188
    height: 18
    margin-top: 10
    margin-left: 12
    color: #8f72e5
    font: terminus-14px-bold

  TextList
    id: categories
    anchors.top: categoriesLabel.bottom
    anchors.left: filtersPanel.left
    anchors.right: filtersPanel.right
    anchors.bottom: historyButton.top
    margin-top: 3
    focusable: false
    background-color: #0b0b1b00

  Panel
    id: filterBar
    anchors.top: headerBar.bottom
    anchors.left: filtersPanel.right
    anchors.right: parent.right
    height: 36
    background-color: #111127
    border-width: 0 0 1 0
    border-color: #222248

  Label
    id: searchLabel
    text: Search
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: filterBar.left
    width: 44
    height: 14
    margin-left: 12
    color: #6e6ea8
    font: terminus-14px-bold
    text-auto-resize: false

  TextEdit
    id: search
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: searchLabel.right
    width: 178
    height: 22
    margin-left: 5
    @onKeyPress: modules.game_store.onSearch()

  Label
    id: sortLabel
    text: Sort
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: search.right
    width: 30
    height: 14
    margin-left: 14
    color: #6e6ea8
    font: terminus-14px-bold
    text-auto-resize: false

  ComboBox
    id: sortCombo
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: sortLabel.right
    width: 162
    height: 22
    margin-left: 5

  CheckBox
    id: onSaleCheck
    !text: 'On Sale Only'
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: sortCombo.right
    margin-left: 14
    color: #9a8ad0

  Panel
    id: topPanel
    anchors.top: filterBar.bottom
    anchors.left: filtersPanel.right
    anchors.right: parent.right
    height: 78
    background-color: #0c0c20
    border-width: 0 0 1 0
    border-color: #1d1d42

    Panel
      id: categoryItemBg
      anchors.left: parent.left
      anchors.top: parent.top
      width: 62
      height: 62
      margin-left: 12
      margin-top: 8
      background-color: #090913
      border-width: 1
      border-color: #272756

    Label
      id: selectedCategory
      anchors.left: categoryItemBg.right
      anchors.top: parent.top
      margin-left: 10
      margin-top: 14
      width: 280
      height: 18
      color: #f0f0ff
      font: terminus-14px-bold

    Label
      id: categoryDescription
      anchors.top: selectedCategory.bottom
      anchors.left: selectedCategory.left
      anchors.right: parent.right
      margin-top: 2
      margin-right: 16
      height: 14
      color: #7070aa

    Label
      id: resultsInfo
      anchors.right: parent.right
      anchors.top: parent.top
      width: 190
      height: 18
      margin-top: 14
      margin-right: 16
      text-align: right
      color: #67f1a3
      font: terminus-14px-bold

  ScrollablePanel
    id: offers
    layout:
      type: grid
      cell-size: 132 158
      flow: true
      cell-spacing: 6
    vertical-scrollbar: offersScrollBar
    anchors.top: topPanel.bottom
    anchors.left: filtersPanel.right
    anchors.right: parent.right
    anchors.bottom: actionBar.top
    background-color: #090916
    border-width: 0
    padding: 8
    focusable: false

  VerticalScrollBar
    id: offersScrollBar
    anchors.top: offers.top
    anchors.bottom: offers.bottom
    anchors.right: offers.right
    step: 84
    pixels-scroll: true

  Panel
    id: emptyState
    anchors.top: offers.top
    anchors.left: offers.left
    anchors.right: offers.right
    anchors.bottom: offers.bottom
    visible: false
    background-color: #090916cc

    Label
      text: 'No offers match your filters'
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      width: 260
      height: 16
      text-align: center
      color: #b6b6df

  TextList
    id: history
    vertical-scrollbar: historyScrollBar
    anchors.top: headerBar.bottom
    anchors.bottom: actionBar.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 2
    padding: 6
    focusable: false
    visible: false
    background-color: #090916

  VerticalScrollBar
    id: historyScrollBar
    anchors.top: history.top
    anchors.bottom: history.bottom
    anchors.right: history.right
    step: 50
    pixels-scroll: true
    visible: false

  Panel
    id: actionBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 34
    background-color: #0b0b1b
    border-width: 1 0 0 0
    border-color: #1d1d40

  Button
    id: backButton
    !text: 'Back'
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 88
    height: 28
    margin-left: 2
    margin-bottom: 2
    @onClick: modules.game_store.hideHistory()
    visible: false

  Button
    id: historyButton
    !text: 'History'
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 88
    height: 28
    margin-left: 2
    margin-bottom: 2
    @onClick: modules.game_store.showHistory()

  Button
    id: buttonCancel
    !text: 'Close'
    width: 76
    height: 28
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 2
    margin-bottom: 2
    @onClick: modules.game_store.hide()

  Button
    id: purchaseButton
    !text: 'Purchase'
    width: 92
    height: 28
    margin-right: 6
    margin-bottom: 2
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.purchase()

  Button
    id: giftButton
    !text: 'Gift'
    width: 64
    height: 28
    margin-right: 6
    margin-bottom: 2
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.gift()
