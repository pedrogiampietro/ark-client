// ══════════════════════════════════════════════════════════════
//  Game Store — Redesign (Mehah-pattern compliant)
//
//  Rules followed from source research:
//  - Filter widgets are DIRECT children of MainWindow (no nesting)
//    so getChildById() works without recursive lookup
//  - No anchors on children inside layout-managed containers
//  - Vertical category nav (reliable focus/event system)
//  - Horizontal filter bar above grid via sibling-anchor chaining
//
//  Palette:
//    deep    #080814    surface  #0d0d1e    raised   #131326
//    bdr     #1c1c3a    focus    #7755cc    gold     #d4a843
//    green   #4dff8c    muted    #50507a    dim      #303060
//    salebg  #2e0d36    salebdr  #8822aa    saletxt  #e880ff
// ══════════════════════════════════════════════════════════════

// ── Category nav row (vertical sidebar) ───────────────────────
ShopCategory < Panel
  height: 32
  focusable: true
  background-color: #09091a00
  border-width: 0 0 1 0
  border-color: #13133000

  $focus:
    background-color: #1e1544cc
    border-color: #141434

  $hover !focus:
    background-color: #10103355

  Label
    id: name
    anchors.fill: parent
    margin-left: 16
    margin-top: 8
    color: #50508a
    text-align: left

// ── Category icon types ────────────────────────────────────────
CategoryIconSprite < UISprite
  id: categoryItem
  anchors.fill: parent

CategoryIconItem < UIItem
  id: categoryItem
  anchors.fill: parent
  virtual: true

CategoryIconCreature < UICreature
  id: categoryItem
  anchors.fill: parent

// ── Offer card ─────────────────────────────────────────────────
OfferWidget < Panel
  focusable: true
  size: 120 140
  background-color: #0d0d1e
  border-width: 1
  border-color: #1c1c3a
  margin-left: 4
  margin-top: 4
  phantom: false
  @onDoubleClick: modules.game_store.purchaseDouble(self)

  $focus:
    background-color: #16093a
    border-color: #7755cc

  $hover !focus:
    background-color: #111130
    border-color: #282852

  // Hidden label — full title for purchase/gift logic
  Label
    id: offerNameHidden
    visible: false

  // Sale badge — top-right corner
  Label
    id: offerSale
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 4
    margin-right: 4
    width: 34
    height: 13
    background-color: #2e0d36
    border-width: 1
    border-color: #8822aa
    color: #e880ff
    text-align: center
    text: SALE
    visible: false

  // Artwork / icon area
  Panel
    id: offerTypePanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 86
    background-color: #080816
    border-width: 0 0 1 0
    border-color: #18183a
    margin-top: 2
    margin-left: 2
    margin-right: 2

  // Item name (below icon)
  Label
    id: offerName
    anchors.top: offerTypePanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: center
    color: #a0a0cc
    margin-top: 4
    margin-left: 3
    margin-right: 3

  // Price (pinned to bottom)
  Label
    id: offerPrice
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    &baseText: '%s points'
    color: #4dff8c
    text-align: center
    font: terminus-14px-bold
    margin-bottom: 4

// ── Offer icon helpers ─────────────────────────────────────────
OfferIconItem < UIItem
  id: offerIcon
  size: 32 32
  padding: 1
  anchors.centerIn: parent
  virtual: true
  phantom: true

OfferIconCreature < UICreature
  id: offerIcon
  size: 64 64
  anchors.centerIn: parent
  phantom: true

// ── History row ────────────────────────────────────────────────
HistoryLabel < Label
  height: 22
  focusable: true
  background: alpha
  color: #8888b8
  margin-left: 6

  $focus:
    background: #1c1a3a
    color: #c0a8ff

// ══════════════════════════════════════════════════════════════
//  Main Window  830 × 522
//
//  Visual zones (all DIRECT children of storeWindow):
//
//  ┌─────────────────────────────────────────────────────┐
//  │  headerBar  (full width, 62px)                      │
//  ├────────────┬──────────────────────────────────────── │
//  │ filtersPanel│  filterBar  (30px)                    │
//  │ (sidebar   ├──────────────────────────────────────── │
//  │  176px)    │  offers  (ScrollablePanel)             │
//  │            │                                         │
//  ├────────────┴────────────────────────────────────────┤
//  │  action buttons  (bottom, 26px)                     │
//  └─────────────────────────────────────────────────────┘
// ══════════════════════════════════════════════════════════════
MainWindow
  id: storeWindow
  !text: 'Game Store'
  size: 830 522
  @onEscape: modules.game_store.hide()

  // ── HEADER BAR ─────────────────────────────────────────
  Panel
    id: headerBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 62
    background-color: #0d0d1e
    border-width: 0 0 1 0
    border-color: #26146a

    // Branding — left side
    Label
      text: GAME STORE
      anchors.top: parent.top
      anchors.left: parent.left
      height: 26
      margin-top: 10
      margin-left: 16
      font: terminus-14px-bold
      color: #d4a843

    Label
      text: Browse and purchase exclusive items for your character
      anchors.top: prev.bottom
      anchors.left: parent.left
      height: 14
      margin-left: 16
      margin-top: 2
      color: #30306a

    // Wallet — right side
    Panel
      id: infoPanel
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 188
      background-color: #09091a
      border-width: 0 0 0 1
      border-color: #1c1c3a
      padding: 8

      Label
        id: points
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        &baseText: 'Balance: %s'
        text-auto-resize: false
        text-align: right
        font: terminus-14px-bold
        color: #dcdcec
        height: 22

      Button
        id: buyPoints
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        width: 108
        height: 20
        !text: '+ Get Coins'
        color: #4dff8c
        @onClick: modules.game_store.buyPoints()

  // ── LEFT SIDEBAR — background panel ────────────────────
  //  (All category widgets are siblings that visually
  //   overlap this panel — original Mehah pattern)
  Panel
    id: filtersPanel
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.bottom: historyButton.top
    width: 174
    background-color: #09091a
    border-width: 0 1 0 0
    border-color: #191936

  // "CATEGORIES" section label
  Label
    id: categoriesLabel
    text: CATEGORIES
    anchors.top: filtersPanel.top
    anchors.left: filtersPanel.left
    width: 174
    height: 18
    margin-top: 8
    margin-left: 12
    color: #7755cc
    font: terminus-14px-bold

  // Vertical category list (reliable TextList approach)
  TextList
    id: categories
    anchors.top: categoriesLabel.bottom
    anchors.left: filtersPanel.left
    anchors.right: filtersPanel.right
    anchors.bottom: historyButton.top
    margin-top: 2
    focusable: false
    background-color: #09091a00

  // ── FILTER BAR — above grid, right of sidebar ──────────
  //  (Background panel — filter widgets are siblings below)
  Panel
    id: filterBar
    anchors.top: headerBar.bottom
    anchors.left: filtersPanel.right
    anchors.right: parent.right
    height: 30
    background-color: #0c0c1e
    border-width: 0 0 1 0
    border-color: #191936

  // Search input (direct child of storeWindow, overlaps filterBar)
  Label
    id: searchLabel
    text: Search
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: filterBar.left
    width: 44
    height: 14
    margin-left: 10
    color: #34346a
    font: terminus-14px-bold
    text-auto-resize: false

  TextEdit
    id: search
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: searchLabel.right
    width: 154
    height: 20
    margin-left: 4
    @onKeyPress: modules.game_store.onSearch()

  // Sort combo (direct child of storeWindow, overlaps filterBar)
  Label
    id: sortLabel
    text: Sort
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: search.right
    width: 30
    height: 14
    margin-left: 12
    color: #34346a
    font: terminus-14px-bold
    text-auto-resize: false

  ComboBox
    id: sortCombo
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: sortLabel.right
    width: 138
    height: 20
    margin-left: 4

  // On Sale filter (direct child of storeWindow, overlaps filterBar)
  CheckBox
    id: onSaleCheck
    !text: 'On Sale'
    anchors.verticalCenter: filterBar.verticalCenter
    anchors.left: sortCombo.right
    margin-left: 14
    color: #7070a0

  // ── OFFERS GRID ────────────────────────────────────────
  ScrollablePanel
    id: offers
    layout:
      type: grid
      cell-size: 120 140
      flow: true
      cell-spacing: 4
    vertical-scrollbar: offersScrollBar
    anchors.top: filterBar.bottom
    anchors.left: filtersPanel.right
    anchors.right: parent.right
    anchors.bottom: historyButton.top
    background-color: #07071200
    border-width: 0
    padding: 4
    focusable: false

  VerticalScrollBar
    id: offersScrollBar
    anchors.top: offers.top
    anchors.bottom: offers.bottom
    anchors.right: offers.right
    step: 74
    pixels-scroll: true

  // ── HISTORY VIEW (hidden by default) ───────────────────
  TextList
    id: history
    vertical-scrollbar: historyScrollBar
    anchors.top: headerBar.bottom
    anchors.bottom: historyButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 2
    padding: 6
    focusable: false
    visible: false
    background-color: #07071200

  VerticalScrollBar
    id: historyScrollBar
    anchors.top: history.top
    anchors.bottom: history.bottom
    anchors.right: history.right
    step: 50
    pixels-scroll: true
    visible: false

  // ── BOTTOM ACTION BUTTONS ───────────────────────────────
  //  Thin background bar
  Panel
    id: actionBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 28
    background-color: #0a0a1a
    border-width: 1 0 0 0
    border-color: #191936

  Button
    id: backButton
    !text: 'Back'
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 82
    height: 26
    @onClick: modules.game_store.hideHistory()
    visible: false

  Button
    id: historyButton
    !text: 'History'
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 82
    height: 26
    @onClick: modules.game_store.showHistory()

  Button
    id: buttonCancel
    !text: 'Close'
    width: 72
    height: 26
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_store.hide()

  Button
    id: purchaseButton
    !text: 'Purchase'
    width: 82
    height: 26
    margin-right: 6
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.purchase()

  Button
    id: giftButton
    !text: 'Gift'
    width: 58
    height: 26
    margin-right: 6
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_store.gift()
