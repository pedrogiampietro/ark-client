MainWindow
  size: 320 168
  !text: 'Send as Gift'
  @onEnter: modules.game_store.confirmGift()

  Panel
    anchors.fill: parent
    background-color: #131922
    border-width: 1
    border-color: #314053

  Label
    text: 'Recipient Character'
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    text-align: left
    color: #ebe6d8
    margin-top: 14
    margin-left: 14

  Label
    text: 'Type the exact name to deliver this gift safely.'
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 14
    text-align: left
    color: #8691a5
    margin-top: 2
    margin-left: 14

  TextEdit
    id: targetName
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22
    margin-top: 8
    margin-left: 14
    margin-right: 14
    background-color: #111821
    border-width: 1
    border-color: #374354
    color: #e6ebf2

  Button
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    !text: 'Send Gift'
    width: 96
    height: 26
    margin-right: 14
    margin-bottom: 10
    @onClick: modules.game_store.confirmGift()

  Button
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    !text: 'Cancel'
    width: 84
    height: 26
    margin-left: 14
    margin-bottom: 10
    @onClick: modules.game_store.cancelGift()
