MainWindow
  size: 320 168
  !text: 'Send as Gift'
  @onEnter: modules.game_store.confirmGift()

  Panel
    anchors.fill: parent
    background-color: #1c1814
    border-width: 1
    border-color: #54483c

  Label
    text: 'Recipient Character'
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    text-align: left
    color: #ebe6d8
    margin-top: 14
    margin-left: 14

  Label
    text: 'Type the exact name to deliver this gift safely.'
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 14
    text-align: left
    color: #a89b8a
    margin-top: 2
    margin-left: 14

  TextEdit
    id: targetName
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22
    margin-top: 8
    margin-left: 14
    margin-right: 14
    background-color: #1a1612
    border-width: 1
    border-color: #54483c
    color: #efe4d6

  Button
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    !text: 'Send Gift'
    width: 96
    height: 26
    margin-right: 14
    margin-bottom: 10
    @onClick: modules.game_store.confirmGift()

  Button
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    !text: 'Cancel'
    width: 84
    height: 26
    margin-left: 14
    margin-bottom: 10
    @onClick: modules.game_store.cancelGift()
