TooltipLabel < Label
  anchors.top: prev.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  font: verdana-11px-rounded
  text-align: center

TooltipSection < Label
  anchors.top: prev.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  font: verdana-11px-rounded
  text-align: center
  color: #b8922a
  margin-top: 3
  margin-bottom: 1

TooltipSeparator < HorizontalSeparator
  anchors.top: prev.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  margin-top: 3

TooltipEmpty < UIWidget
  anchors.top: prev.bottom
  anchors.left: parent.left
  anchors.right: parent.right

FlatPanel
  background-color: #0f0f0f

  UIWidget
    id: tooltipHeader
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 56
    background-color: #1f0d00

  UIItem
    id: itemSprite
    font: verdana-11px-rounded
    virtual: true
    anchors.top: parent.top
    anchors.left: parent.left
    size: 40 40
    margin-top: 8
    margin-left: 8

  Label
    id: itemNameLabel
    font: verdana-11px-rounded
    anchors.top: parent.top
    anchors.left: parent.left
    text-auto-resize: true
    margin-top: 9
    margin-left: 56
    margin-right: 6
    color: #ffffff

  Label
    id: itemTypeLabel
    font: verdana-11px-rounded
    anchors.top: prev.bottom
    anchors.left: parent.left
    text-auto-resize: true
    margin-top: 2
    margin-left: 56
    margin-right: 6
    color: #aaaaaa

  Label
    id: itemWeightLabel
    font: verdana-11px-rounded
    anchors.top: parent.top
    anchors.right: parent.right
    text-auto-resize: true
    margin-top: 5
    margin-right: 5

  Panel
    id: labels
    background-color: #0f0f0f
    anchors.fill: parent
    margin-top: 61
    margin-bottom: 5
    margin-left: 4
    margin-right: 4
