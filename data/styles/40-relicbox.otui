RelicBoxButton < UIButton
  id: relicBoxButton
  height: 20
  margin-top: 2
  image-source: /images/ui/relics
  image-align: center
  !tooltip: tr('Relic Box')

RelicSlot < Item
  size: 34 34
  image-source: /images/game/slots/finger
  border-width: 1
  border-color: #8B691488
  background-color: #1A120899

  $on:
    image-source: /images/ui/item-blessed

RelicBoxWindow < MiniWindow
  !title: tr('Relic Box')
  height: 100
  width: 170
  id: relicBoxWindow
  &save: true
  @onClose: modules.game_relicbox.onWindowClose()

  MiniWindowContents
    Panel
      id: slotsGrid
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 4
      height: 38
      layout:
        type: horizontalBox
        spacing: 4

      RelicSlot
        id: relicSlot1
        !tooltip: tr('Relic Slot 1')

      RelicSlot
        id: relicSlot2
        !tooltip: tr('Relic Slot 2')

      RelicSlot
        id: relicSlot3
        !tooltip: tr('Relic Slot 3')

      RelicSlot
        id: relicSlot4
        !tooltip: tr('Relic Slot 4')

    Label
      !text: tr('Right-click a slot to remove a relic.')
      font: cipsoftFont
      color: #AA8844
      text-auto-resize: true
      anchors.top: slotsGrid.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 4
