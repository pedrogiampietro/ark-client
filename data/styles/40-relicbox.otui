RelicBoxButton < UIButton
  id: relicBoxButton
  height: 20
  background-color: #0D0D0DCC
  border-width: 1
  border-color: #555555BB
  icon: /images/ui/relics
  icon-clip: 6 6 20 20
  !tooltip: tr('Relic Box')

  $hover:
    border-color: #FFD700BB
    background-color: #1A1200CC

  $on:
    border-color: #FFD700
    background-color: #2A1A00CC

RelicSlot < Item
  size: 34 34
  border-width: 1
  border-color: #55442266
  background-color: #0D0A0599
  image-source: /images/ui/relics_add
  image-color: #FFFFFF88

  $on:
    image-source: /images/ui/item-blessed

RelicBoxWindow < MiniWindow
  !text: tr('Relics Box')
  height: 100
  width: 170
  id: relicBoxWindow
  &save: true
  &autoOpen: 99
  @onClose: modules.game_relicbox.onWindowClose()

  MiniWindowContents
    Panel
      id: slotsGrid
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 4
      height: 38
      layout:
        type: horizontalBox
        spacing: 4

      RelicSlot
        id: relicSlot1
        !tooltip: tr('Relic Slot 1')

      RelicSlot
        id: relicSlot2
        !tooltip: tr('Relic Slot 2')

      RelicSlot
        id: relicSlot3
        !tooltip: tr('Relic Slot 3')

      RelicSlot
        id: relicSlot4
        !tooltip: tr('Relic Slot 4')

    Label
      !text: tr('Right-click a slot to remove a relic.')
      font: cipsoftFont
      color: #E8C86A
      text-auto-resize: true
      anchors.top: slotsGrid.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 4
