ForgeItemSlot < UIItem
  size: 34 34
  padding: 1
  image-source: /images/ui/item
  border-width: 1
  border-color: #555555
  &selectable: true
  &canDrop: true

  $disabled:
    color: #646464

ForgeWindow < MainWindow
  id: forgeWindow
  !text: tr('Forge Item')
  size: 700 550
  @onEscape: modules.game_forge.toggle()

  TabBar
    id: forgeTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  Panel
    id: forgeContent
    anchors.top: forgeTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 5
    margin-bottom: 8

  Button
    id: closeButton
    !text: tr('Close')
    width: 64
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: modules.game_forge.toggle()

// ========== CLASSIFICATION TAB (TIER) ==========
ForgeClassificationTab < Panel
  id: classificationTab

  FlatPanel
    id: classInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 46
    margin-top: 2

    Label
      id: classInfoLabel
      anchors.fill: parent
      margin: 5
      text-wrap: true
      text-auto-resize: true
      !text: tr('Increase the classification (tier) of your item. Drag an item to the slot below. Higher tiers unlock more enchantment slots.')
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: classSourcePanel
    anchors.top: classInfoPanel.bottom
    anchors.left: parent.left
    width: 295
    height: 130
    margin-top: 8

    Label
      id: classSourceTitle
      !text: tr('Source Item')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Panel
      id: classItemContainer
      size: 36 36
      anchors.top: classSourceTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      border-width: 1
      border-color: #555555
      background-color: #ffffff11

      ForgeItemSlot
        id: classSourceItem
        anchors.fill: parent

    Label
      id: classPlaceholder
      !text: tr('Drag item here')
      text-align: center
      anchors.top: classItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #666666

    Label
      id: classSourceTierLabel
      text-align: center
      anchors.top: classPlaceholder.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #c0c0c0

  UIWidget
    id: classArrow
    image-source: /images/ui/arrow_horizontal
    size: 32 32
    anchors.verticalCenter: classSourcePanel.verticalCenter
    anchors.left: classSourcePanel.right
    margin-left: 10

  FlatPanel
    id: classResultPanel
    anchors.top: classSourcePanel.top
    anchors.right: parent.right
    width: 295
    height: 130

    Label
      id: classResultTitle
      !text: tr('Result')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Label
      id: classResultTierLabel
      text-align: center
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: classResultMessage
      text-align: center
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 8
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: classChancePanel
    anchors.top: classSourcePanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 155
    margin-top: 8

    Label
      id: classChanceTitle
      !text: tr('Tier Upgrade')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Label
      id: classChanceLabel
      text-align: center
      anchors.top: classChanceTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: classMaterialLabel
      text-align: center
      anchors.top: classChanceLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: classCostLabel
      text-align: center
      anchors.top: classMaterialLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #ffcc00

    Button
      id: classBonusButton
      !text: tr('+20%')
      width: 50
      height: 22
      anchors.top: classCostLabel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      color: #3399ff

    ProgressBar
      id: classProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: classBonusButton.bottom
      margin-left: 60
      margin-right: 60
      margin-top: 4
      height: 12
      background-color: #00aa00
      visible: false

    Button
      id: classForgeButton
      !text: tr('Forge')
      width: 80
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 8
      enabled: false

// ========== ATTRIBUTES TAB (ENCHANTMENTS) ==========
ForgeAttributesTab < Panel
  id: attributesTab

  FlatPanel
    id: attrInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 46
    margin-top: 2

    Label
      id: attrInfoLabel
      anchors.fill: parent
      margin: 5
      text-wrap: true
      text-auto-resize: true
      !text: tr('Manage enchantments on your items. The item must have a tier to receive enchantments. Higher tiers have more slots available.')
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: attrItemPanel
    anchors.top: attrInfoPanel.bottom
    anchors.left: parent.left
    width: 295
    height: 150
    margin-top: 8

    Label
      id: attrItemTitle
      !text: tr('Source Item')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

    Panel
      id: attrItemContainer
      size: 36 36
      anchors.top: attrItemTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      border-width: 1
      border-color: #555555
      background-color: #ffffff11

      ForgeItemSlot
        id: attrSourceItem
        anchors.fill: parent

    Label
      id: attrPlaceholder
      !text: tr('Drag item here')
      text-align: center
      anchors.top: attrItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #666666

    Label
      id: attrItemInfo
      text-align: center
      anchors.top: attrPlaceholder.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: attrResultMessage
      text-align: center
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 4
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: attrEnchantPanel
    anchors.top: attrInfoPanel.bottom
    anchors.right: parent.right
    width: 355
    height: 150
    margin-top: 8

    Label
      id: attrEnchantTitle
      !text: tr('Enchantments')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

    ScrollableFlatPanel
      id: attrEnchantList
      anchors.top: attrEnchantTitle.bottom
      anchors.left: parent.left
      anchors.right: attrEnchantScroll.left
      anchors.bottom: parent.bottom
      margin: 5
      vertical-scrollbar: attrEnchantScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: attrEnchantScroll
      anchors.top: attrEnchantTitle.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 5
      margin-bottom: 5
      step: 16
      pixels-scroll: true

  FlatPanel
    id: attrActionPanel
    anchors.top: attrItemPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 115
    margin-top: 8

    Label
      id: attrMaterialLabel
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: attrCostLabel
      text-align: center
      anchors.top: attrMaterialLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #ffcc00

    ProgressBar
      id: attrProgressBar
      anchors.top: attrCostLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 60
      margin-right: 60
      margin-top: 4
      height: 12
      background-color: #00aa00
      visible: false

    Button
      id: attrAddEnchant
      !text: tr('Add Enchant')
      width: 110
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom: 8
      margin-left: 8
      enabled: false

    Button
      id: attrRerollLast
      !text: tr('Reroll Last')
      width: 100
      anchors.bottom: parent.bottom
      anchors.left: attrAddEnchant.right
      margin-bottom: 8
      margin-left: 6
      enabled: false

    Button
      id: attrRerollAll
      !text: tr('Reroll All')
      width: 100
      anchors.bottom: parent.bottom
      anchors.left: attrRerollLast.right
      margin-bottom: 8
      margin-left: 6
      enabled: false

    Button
      id: attrRemoveLast
      !text: tr('Remove Last')
      width: 100
      anchors.bottom: parent.bottom
      anchors.left: attrRerollAll.right
      margin-bottom: 8
      margin-left: 6
      enabled: false

    Button
      id: attrRemoveAll
      !text: tr('Remove All')
      width: 100
      anchors.bottom: parent.bottom
      anchors.left: attrRemoveLast.right
      margin-bottom: 8
      margin-left: 6
      enabled: false

// ========== TOOLS TAB (UPGRADE) ==========
ForgeToolsTab < Panel
  id: toolsTab

  FlatPanel
    id: toolsInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 46
    margin-top: 2

    Label
      id: toolsInfoLabel
      anchors.fill: parent
      margin: 5
      text-wrap: true
      text-auto-resize: true
      !text: tr('Upgrade your equipment to improve its stats. Higher upgrade levels have lower chances of success. Failed upgrades may downgrade the item.')
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: toolsSourcePanel
    anchors.top: toolsInfoPanel.bottom
    anchors.left: parent.left
    width: 295
    height: 130
    margin-top: 8

    Label
      id: toolsSourceTitle
      !text: tr('Source Item')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

    Panel
      id: toolsItemContainer
      size: 36 36
      anchors.top: toolsSourceTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      border-width: 1
      border-color: #555555
      background-color: #ffffff11

      ForgeItemSlot
        id: toolsSourceItem
        anchors.fill: parent

    Label
      id: toolsPlaceholder
      !text: tr('Drag item here')
      text-align: center
      anchors.top: toolsItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #666666

    Label
      id: toolsSourceLevelLabel
      text-align: center
      anchors.top: toolsPlaceholder.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #c0c0c0

  UIWidget
    id: toolsArrow
    image-source: /images/ui/arrow_horizontal
    size: 32 32
    anchors.verticalCenter: toolsSourcePanel.verticalCenter
    anchors.left: toolsSourcePanel.right
    margin-left: 10

  FlatPanel
    id: toolsResultPanel
    anchors.top: toolsSourcePanel.top
    anchors.right: parent.right
    width: 295
    height: 130

    Label
      id: toolsResultTitle
      !text: tr('Result')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Label
      id: toolsResultLevelLabel
      text-align: center
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: toolsResultMessage
      text-align: center
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 8
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: toolsChancePanel
    anchors.top: toolsSourcePanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 155
    margin-top: 8

    Label
      id: toolsChanceTitle
      !text: tr('Upgrade')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Label
      id: toolsChanceLabel
      text-align: center
      anchors.top: toolsChanceTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: toolsMaterialLabel
      text-align: center
      anchors.top: toolsChanceLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: toolsCostLabel
      text-align: center
      anchors.top: toolsMaterialLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #ffcc00

    Button
      id: toolsBonusButton
      !text: tr('+20%')
      width: 50
      height: 22
      anchors.top: toolsCostLabel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      color: #3399ff

    ProgressBar
      id: toolsProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: toolsBonusButton.bottom
      margin-left: 60
      margin-right: 60
      margin-top: 4
      height: 12
      background-color: #00aa00
      visible: false

    Button
      id: toolsForgeButton
      !text: tr('Forge')
      width: 80
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 8
      enabled: false

ForgeWindow
