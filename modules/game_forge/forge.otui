// ============================================================
// FORGE ITEM MODULE - UI Definitions
// ============================================================

// ---- Fragment slot widget (used in Classification & Tools) --
ForgeFragmentSlot < Panel
  size: 82 122

  Panel
    id: slotBg
    size: 70 70
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    background-color: #0e1320
    border-width: 1
    border-color: #2d4060

    UIItem
      id: runeItem
      size: 48 48
      anchors.centerIn: parent
      virtual: true

  Panel
    id: runeCountBox
    height: 22
    anchors.top: slotBg.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    background-color: #080c14
    border-width: 1
    border-color: #1e2d45

    Label
      id: runeCount
      anchors.fill: parent
      text-align: center
      font: verdana-11px-antialised
      color: #a0b8d0

  Label
    id: runeLabel
    anchors.top: runeCountBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 13
    text-align: center
    font: verdana-11px-antialised
    color: #6680aa

// ---- Enchantment slot (smaller, used in Attributes tab) ----
ForgeAttrSlot < Panel
  size: 82 122

  Panel
    id: slotBg
    size: 70 70
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    background-color: #0e1320
    border-width: 1
    border-color: #2d4060

    UIItem
      id: runeItem
      size: 48 48
      anchors.centerIn: parent
      virtual: true

  Panel
    id: runeCountBox
    height: 22
    anchors.top: slotBg.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    background-color: #080c14
    border-width: 1
    border-color: #1e2d45

    Label
      id: runeCount
      anchors.fill: parent
      text-align: center
      font: verdana-11px-antialised
      color: #a0b8d0

  Label
    id: runeLabel
    anchors.top: runeCountBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 13
    text-align: center
    font: verdana-11px-antialised
    color: #6680aa

// ---- Item preview slot (Source / Result panels) -------------
ForgeItemSlot < UIItem
  size: 34 34
  padding: 1
  border-width: 0
  &selectable: true
  &canDrop: true

  $disabled:
    color: #646464

// ---- Single enchantment row (Attributes tab list) ----------
ForgeEnchantRow < Panel
  height: 20

  Label
    id: slotIndex
    width: 20
    text-align: right
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-antialised
    color: #506080

  Label
    id: enchantName
    anchors.left: slotIndex.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-antialised
    color: #80d4b0

// ============================================================
// MAIN WINDOW
// ============================================================
ForgeWindow < MainWindow
  id: forgeWindow
  !text: tr('Forge Item')
  size: 720 590
  @onEscape: modules.game_forge.toggle()

  TabBar
    id: forgeTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  Panel
    id: forgeContent
    anchors.top: forgeTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: forgeBottomBar.top
    margin-top: 4
    margin-bottom: 4

  // Bottom bar: gold balance + close button
  Panel
    id: forgeBottomBar
    height: 30
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 2

    Panel
      id: forgeBalanceIcon
      size: 22 22
      image-source: /images/ui/crystal_coin
      image-size: 22 22
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2

    Label
      id: forgeBalanceLabel
      anchors.left: forgeBalanceIcon.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      width: 50
      font: verdana-11px-antialised
      color: #ffd700
      text-align: left

    Button
      id: closeButton
      !text: tr('Close')
      width: 70
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      @onClick: modules.game_forge.toggle()


// ============================================================
// CLASSIFICATION TAB (TIER)
// ============================================================
ForgeClassificationTab < Panel
  id: classificationTab

  // -- Description banner --
  FlatPanel
    id: classInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: classInfoLabel
      anchors.fill: parent
      margin: 5 12 5 12
      text-wrap: true
      text-auto-resize: false
      !text: tr('Increase the classification (tier) of your item. Drag an item to the slot below. Higher tiers unlock more enchantment slots.')
      font: verdana-11px-antialised
      color: #8099b8

  // -- Source / Result row --
  Panel
    id: classPreviewRow
    height: 130
    anchors.top: classInfoPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

    // Source panel
    FlatPanel
      id: classSourcePanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 220

      Label
        id: classSourceTitle
        !text: tr('Source Item')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #a0b8cc

      Panel
        id: classItemContainer
        size: 52 52
        anchors.top: classSourceTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        ForgeItemSlot
          id: classSourceItem
          size: 48 48
          anchors.centerIn: parent

      Label
        id: classPlaceholder
        !text: tr('Drag item here')
        text-align: center
        anchors.top: classItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 3
        font: verdana-11px-antialised
        color: #40506a

      Label
        id: classSourceTierLabel
        text-align: center
        anchors.top: classPlaceholder.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 1
        font: verdana-11px-antialised
        color: #8099b8

    // Arrow
    UIWidget
      id: classArrow
      image-source: /images/ui/arrow_horizontal
      image-clip: 0 0 24 21
      size: 24 21
      anchors.verticalCenter: classSourcePanel.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter

    // Result panel
    FlatPanel
      id: classResultPanel
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 220

      Label
        id: classResultTitle
        !text: tr('Result')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #a0b8cc

      Panel
        id: classResultItemContainer
        size: 52 52
        anchors.top: classResultTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        UIItem
          id: classResultItem
          size: 48 48
          anchors.centerIn: parent
          virtual: true

      Label
        id: classResultTierLabel
        text-align: center
        anchors.top: classResultItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        font: verdana-11px-antialised
        color: #a0b8cc

      Label
        id: classResultMessage
        text-align: center
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 5
        font: verdana-11px-antialised
        color: #a0b8cc

  // -- Materials area --
  FlatPanel
    id: classActionPanel
    anchors.top: classPreviewRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6

    // Section title
    Label
      id: classMatSectionTitle
      !text: tr('Required Materials')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #c8d8e8

    // Sub-hint
    Label
      id: classMatTitle
      !text: tr('You can increase the success chance by 20%% using the bonus option.')
      text-align: center
      text-wrap: true
      height: 14
      anchors.top: classMatSectionTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 16
      margin-right: 16
      font: verdana-11px-antialised
      color: #506070

    // Materials + action row
    Panel
      id: classActionRow
      height: 128
      anchors.top: classMatTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6

      // Fragment slot (left-aligned group)
      Panel
        id: classSlotsGroup
        width: 182
        height: 122
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 14
        margin-top: 3

        ForgeFragmentSlot
          id: classTierRuneSlot
          anchors.top: parent.top
          anchors.left: parent.left

        ForgeFragmentSlot
          id: classProtRuneSlot
          anchors.top: parent.top
          anchors.left: classTierRuneSlot.right
          margin-left: 8

      // Separator line
      UIWidget
        id: classSlotSep
        width: 1
        background-color: #1e2d45
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: classSlotsGroup.right
        margin-left: 12
        margin-top: 8
        margin-bottom: 8

      // Bonus button group
      Panel
        id: classBonusGroup
        width: 80
        height: 90
        anchors.top: parent.top
        anchors.left: classSlotSep.right
        margin-left: 14
        margin-top: 12

        UIWidget
          id: classBonusButton
          size: 60 60
          image-source: /images/ui/20
          image-clip: 0 0 66 66
          image-size: 60 60
          image-color: #ffffff
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter

          $on:
            image-clip: 66 0 66 66

          $pressed:
            image-color: #bbbbbb

        Panel
          id: classBonusCostRow
          anchors.top: classBonusButton.bottom
          anchors.horizontalCenter: classBonusButton.horizontalCenter
          margin-top: 6
          width: 60
          height: 20

          Panel
            image-source: /images/ui/crystal_coin
            image-size: 18 18
            size: 18 18
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter

          Label
            id: classBonusCostLabel
            text-align: left
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 22
            width: 36
            height: 16
            font: verdana-11px-antialised
            color: #ffd700

      // Arrow → Chance
      UIWidget
        id: classForgeArrow
        image-source: /images/ui/arrow_horizontal
        image-clip: 12 0 12 21
        size: 12 21
        anchors.verticalCenter: classBonusGroup.verticalCenter
        anchors.left: classBonusGroup.right
        margin-left: 10
        phantom: false

      Panel
        id: classChancePanel
        width: 80
        height: 40
        anchors.verticalCenter: classBonusGroup.verticalCenter
        anchors.left: classForgeArrow.right
        margin-left: 8

        Label
          id: classChanceLabel
          anchors.fill: parent
          text-align: center
          font: verdana-11px-antialised
          color: #a0b8cc
          text-wrap: true

      // Forge button + cost
      Panel
        id: classForgeGroup
        width: 132
        height: 96
        anchors.top: parent.top
        anchors.right: parent.right
        margin-right: 14
        margin-top: 10

        UIButton
          id: classForgeButton
          size: 128 66
          image-source: /images/game/imbuing/imbue_green
          image-clip: 0 0 128 66
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          enabled: false
          image-color: #90e890

          $pressed:
            image-clip: 0 66 128 66

          $disabled:
            image-color: #445544

        Panel
          id: classCostRow
          anchors.top: classForgeButton.bottom
          anchors.horizontalCenter: classForgeButton.horizontalCenter
          margin-top: 6
          width: 80
          height: 20

          Panel
            image-source: /images/ui/crystal_coin
            image-size: 18 18
            size: 18 18
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter

          Label
            id: classCostLabel
            text-align: left
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 22
            width: 56
            height: 16
            font: verdana-11px-antialised
            color: #ffd700

    // Status label
    Label
      id: classMaterialLabel
      text-align: center
      anchors.top: classActionRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 16
      margin-right: 16
      font: verdana-11px-antialised
      color: #8099b8
      text-wrap: true
      height: 16

    ProgressBar
      id: classProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 80
      margin-right: 80
      margin-bottom: 5
      height: 10
      background-color: #2255aa
      visible: false


// ============================================================
// ATTRIBUTES TAB (ENCHANTMENTS)
// ============================================================
ForgeAttributesTab < Panel
  id: attributesTab

  // -- Info banner --
  FlatPanel
    id: attrInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: attrInfoLabel
      anchors.fill: parent
      margin: 5 8 5 8
      text-wrap: true
      text-auto-resize: false
      !text: tr('Modify your item\'s attributes. Drag an item to the slot. Selecting a specific attribute costs more than a random one.')
      font: verdana-11px-antialised
      color: #8099b8

  // -- Left column: source item + enchantments list --
  FlatPanel
    id: attrItemPanel
    anchors.top: attrInfoPanel.bottom
    anchors.left: parent.left
    width: 226
    anchors.bottom: attrResultPanel.top
    margin-top: 6
    margin-bottom: 6

    Label
      id: attrItemTitle
      !text: tr('Source Item')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      font: verdana-11px-antialised
      color: #a0b8cc

    Panel
      id: attrItemContainer
      size: 52 52
      anchors.top: attrItemTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
      image-source: /images/ui/slot
      image-size: 52 52

      ForgeItemSlot
        id: attrSourceItem
        size: 48 48
        anchors.centerIn: parent

    Label
      id: attrPlaceholder
      !text: tr('Drag item here')
      text-align: center
      anchors.top: attrItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      font: verdana-11px-antialised
      color: #40506a

    Label
      id: attrItemInfo
      text-align: center
      anchors.top: attrPlaceholder.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #8099b8

    Label
      id: attrEnchantTitle
      !text: tr('Current Enchantments')
      text-align: center
      anchors.top: attrItemInfo.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #c8d8e8

    UIWidget
      id: attrEnchantDivider
      height: 1
      background-color: #1e2d45
      anchors.top: attrEnchantTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 8
      margin-right: 8

    ScrollableFlatPanel
      id: attrEnchantList
      anchors.top: attrEnchantDivider.bottom
      anchors.left: parent.left
      anchors.right: attrEnchantScroll.left
      anchors.bottom: parent.bottom
      margin: 4 0 6 8
      vertical-scrollbar: attrEnchantScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: attrEnchantScroll
      anchors.top: attrEnchantDivider.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-bottom: 6
      step: 16
      pixels-scroll: true

  // -- Right column: action selector + fragment + cost --
  FlatPanel
    id: attrActionPanel
    anchors.top: attrInfoPanel.bottom
    anchors.right: parent.right
    width: 478
    anchors.bottom: attrResultPanel.top
    margin-top: 6
    margin-bottom: 6

    Label
      id: attrActionTitle
      !text: tr('Enchantment Action')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      font: verdana-11px-antialised
      color: #c8d8e8

    UIWidget
      id: attrActionDivider
      height: 1
      background-color: #1e2d45
      anchors.top: attrActionTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 8
      margin-right: 8

    Label
      id: attrActionLabel
      !text: tr('Action:')
      anchors.top: attrActionDivider.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: 12
      font: verdana-11px-antialised
      color: #8099b8

    ComboBox
      id: attrActionCombo
      anchors.top: attrActionLabel.top
      anchors.left: attrActionLabel.right
      anchors.right: parent.right
      margin-left: 8
      margin-right: 12
      margin-top: -2

    Panel
      id: attrReplacePanel
      height: 90
      anchors.top: attrActionCombo.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4

      Label
        id: attrReplaceSlotLabel
        !text: tr('Slot:')
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 12
        font: verdana-11px-antialised
        color: #8099b8
        visible: false

      ComboBox
        id: attrReplaceSlotCombo
        anchors.top: attrReplaceSlotLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 12
        margin-right: 12
        visible: false

      Label
        id: attrReplaceAttrLabel
        !text: tr('New attribute:')
        anchors.top: attrReplaceSlotCombo.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        margin-left: 12
        margin-right: 12
        font: verdana-11px-antialised
        color: #8099b8
        visible: false

      ComboBox
        id: attrReplaceAttrCombo
        anchors.top: attrReplaceAttrLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 12
        margin-right: 12
        visible: false

    // Fragment slot + cost in same row
    Panel
      id: attrMaterialRow
      height: 130
      anchors.top: attrReplacePanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4

      Label
        id: attrRuneTitle
        !text: tr('Required Fragment (x100):')
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 12
        font: verdana-11px-antialised
        color: #6680aa

      ForgeAttrSlot
        id: attrRuneSlot
        anchors.top: attrRuneTitle.bottom
        anchors.left: parent.left
        margin-top: 4
        margin-left: 12

      Panel
        id: attrCostGroup
        width: 160
        height: 60
        anchors.top: attrRuneTitle.bottom
        anchors.left: attrRuneSlot.right
        margin-left: 20
        margin-top: 10

        Label
          id: attrCostTitle
          !text: tr('Total cost:')
          anchors.top: parent.top
          anchors.left: parent.left
          font: verdana-11px-antialised
          color: #6680aa

        Panel
          id: attrCostIconRow
          height: 24
          anchors.top: attrCostTitle.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 4

          Panel
            image-source: /images/ui/crystal_coin
            image-size: 20 20
            size: 20 20
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter

          Label
            id: attrCostLabel
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 26
            width: 120
            font: verdana-11px-antialised
            color: #ffd700

      Button
        id: attrExecuteButton
        !text: tr('Apply!')
        width: 120
        anchors.top: attrRuneTitle.bottom
        anchors.right: parent.right
        margin-top: 8
        margin-right: 12
        enabled: false

    ProgressBar
      id: attrProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: attrDescPanel.top
      margin-left: 20
      margin-right: 20
      margin-bottom: 4
      height: 10
      background-color: #2255aa
      visible: false

    FlatPanel
      id: attrDescPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 4 8 8 8

      Label
        id: attrDescLabel
        anchors.fill: parent
        margin: 5
        text-wrap: true
        text-auto-resize: true
        font: verdana-11px-antialised
        color: #607090

  // -- Result bar (bottom) --
  FlatPanel
    id: attrResultPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 24

    Label
      id: attrResultMessage
      text-align: center
      anchors.fill: parent
      margin: 4
      font: verdana-11px-antialised
      color: #a0b8cc


// ============================================================
// TOOLS TAB (UPGRADE)
// ============================================================
ForgeToolsTab < Panel
  id: toolsTab

  // -- Description banner --
  FlatPanel
    id: toolsInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: toolsInfoLabel
      anchors.fill: parent
      margin: 5 12 5 12
      text-wrap: true
      text-auto-resize: false
      !text: tr('Upgrade your equipment to improve its stats. Higher upgrade levels have lower success chance. Failed upgrades may downgrade the item.')
      font: verdana-11px-antialised
      color: #8099b8

  // -- Source / Result row --
  Panel
    id: toolsPreviewRow
    height: 130
    anchors.top: toolsInfoPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

    FlatPanel
      id: toolsSourcePanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 220

      Label
        id: toolsSourceTitle
        !text: tr('Source Item')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #a0b8cc

      Panel
        id: toolsItemContainer
        size: 52 52
        anchors.top: toolsSourceTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        ForgeItemSlot
          id: toolsSourceItem
          size: 48 48
          anchors.centerIn: parent

      Label
        id: toolsPlaceholder
        !text: tr('Drag item here')
        text-align: center
        anchors.top: toolsItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 3
        font: verdana-11px-antialised
        color: #40506a

      Label
        id: toolsSourceLevelLabel
        text-align: center
        anchors.top: toolsPlaceholder.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 1
        font: verdana-11px-antialised
        color: #8099b8

    UIWidget
      id: toolsArrow
      image-source: /images/ui/arrow_horizontal
      image-clip: 0 0 24 21
      size: 24 21
      anchors.verticalCenter: toolsSourcePanel.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter

    FlatPanel
      id: toolsResultPanel
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 220

      Label
        id: toolsResultTitle
        !text: tr('Result')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #a0b8cc

      Panel
        id: toolsResultItemContainer
        size: 52 52
        anchors.top: toolsResultTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        UIItem
          id: toolsResultItem
          size: 48 48
          anchors.centerIn: parent
          virtual: true

      Label
        id: toolsResultLevelLabel
        text-align: center
        anchors.top: toolsResultItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        font: verdana-11px-antialised
        color: #a0b8cc

      Label
        id: toolsResultMessage
        text-align: center
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 5
        font: verdana-11px-antialised
        color: #a0b8cc

  // -- Materials area --
  FlatPanel
    id: toolsActionPanel
    anchors.top: toolsPreviewRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6

    Label
      id: toolsMatSectionTitle
      !text: tr('Required Materials')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #c8d8e8

    Label
      id: toolsMatTitle
      !text: tr('You can increase the success chance by 20%% using the bonus option.')
      text-align: center
      text-wrap: true
      height: 14
      anchors.top: toolsMatSectionTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 16
      margin-right: 16
      font: verdana-11px-antialised
      color: #506070

    Panel
      id: toolsActionRow
      height: 128
      anchors.top: toolsMatTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6

      Panel
        id: toolsSlotsGroup
        width: 182
        height: 122
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 14
        margin-top: 3

        ForgeFragmentSlot
          id: toolsUpgradeRuneSlot
          anchors.top: parent.top
          anchors.left: parent.left

        ForgeFragmentSlot
          id: toolsProtRuneSlot
          anchors.top: parent.top
          anchors.left: toolsUpgradeRuneSlot.right
          margin-left: 8

      UIWidget
        id: toolsSlotSep
        width: 1
        background-color: #1e2d45
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: toolsSlotsGroup.right
        margin-left: 12
        margin-top: 8
        margin-bottom: 8

      Panel
        id: toolsBonusGroup
        width: 80
        height: 90
        anchors.top: parent.top
        anchors.left: toolsSlotSep.right
        margin-left: 14
        margin-top: 12

        UIWidget
          id: toolsBonusButton
          size: 60 60
          image-source: /images/ui/20
          image-clip: 0 0 66 66
          image-size: 60 60
          image-color: #ffffff
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter

          $on:
            image-clip: 66 0 66 66

          $pressed:
            image-color: #bbbbbb

        Panel
          id: toolsBonusCostRow
          anchors.top: toolsBonusButton.bottom
          anchors.horizontalCenter: toolsBonusButton.horizontalCenter
          margin-top: 6
          width: 60
          height: 20

          Panel
            image-source: /images/ui/crystal_coin
            image-size: 18 18
            size: 18 18
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter

          Label
            id: toolsBonusCostLabel
            text-align: left
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 22
            width: 36
            height: 16
            font: verdana-11px-antialised
            color: #ffd700

      UIWidget
        id: toolsForgeArrow
        image-source: /images/ui/arrow_horizontal
        image-clip: 12 0 12 21
        size: 12 21
        anchors.verticalCenter: toolsBonusGroup.verticalCenter
        anchors.left: toolsBonusGroup.right
        margin-left: 10
        phantom: false

      Panel
        id: toolsChancePanel
        width: 80
        height: 40
        anchors.verticalCenter: toolsBonusGroup.verticalCenter
        anchors.left: toolsForgeArrow.right
        margin-left: 8

        Label
          id: toolsChanceLabel
          anchors.fill: parent
          text-align: center
          font: verdana-11px-antialised
          color: #a0b8cc
          text-wrap: true

      Panel
        id: toolsForgeGroup
        width: 132
        height: 96
        anchors.top: parent.top
        anchors.right: parent.right
        margin-right: 14
        margin-top: 10

        UIButton
          id: toolsForgeButton
          size: 128 66
          image-source: /images/game/imbuing/imbue_green
          image-clip: 0 0 128 66
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          enabled: false
          image-color: #90e890

          $pressed:
            image-clip: 0 66 128 66

          $disabled:
            image-color: #445544

        Panel
          id: toolsCostRow
          anchors.top: toolsForgeButton.bottom
          anchors.horizontalCenter: toolsForgeButton.horizontalCenter
          margin-top: 6
          width: 80
          height: 20

          Panel
            image-source: /images/ui/crystal_coin
            image-size: 18 18
            size: 18 18
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter

          Label
            id: toolsCostLabel
            text-align: left
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 22
            width: 56
            height: 16
            font: verdana-11px-antialised
            color: #ffd700

    Label
      id: toolsMaterialLabel
      text-align: center
      anchors.top: toolsActionRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 16
      margin-right: 16
      font: verdana-11px-antialised
      color: #8099b8
      text-wrap: true
      height: 16

    ProgressBar
      id: toolsProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 80
      margin-right: 80
      margin-bottom: 5
      height: 10
      background-color: #2255aa
      visible: false


// ============================================================
// INSTANTIATE WINDOW
// ============================================================
ForgeWindow
