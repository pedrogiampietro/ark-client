ForgeItemSlot < UIItem
  size: 34 34
  padding: 1
  border-width: 0
  &selectable: true
  &canDrop: true

  $disabled:
    color: #646464

ForgeRuneSlot < Panel
  size: 80 80

  Panel
    id: slotBg
    size: 48 48
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    image-source: /images/ui/slot
    image-size: 48 48

    UIItem
      id: runeItem
      size: 46 46
      anchors.centerIn: parent
      virtual: true

  Label
    id: runeCount
    text-align: center
    anchors.top: slotBg.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    font: verdana-11px-antialised
    color: #c0c0c0
    height: 14

  Label
    id: runeName
    text-align: center
    anchors.top: runeCount.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    font: verdana-11px-antialised
    color: #888888
    height: 12
    text-auto-resize: true

ForgeEnchantRow < Panel
  height: 20

  Label
    id: slotIndex
    width: 20
    text-align: right
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-antialised
    color: #888888

  Label
    id: enchantName
    anchors.left: slotIndex.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-antialised
    color: #c0ffee

ForgeWindow < MainWindow
  id: forgeWindow
  !text: tr('Forge Item')
  size: 700 570
  @onEscape: modules.game_forge.toggle()

  TabBar
    id: forgeTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  Panel
    id: forgeContent
    anchors.top: forgeTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 5
    margin-bottom: 8

  FlatLabel
    id: forgeBalanceLabel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 120
    height: 20
    margin-bottom: 2
    font: verdana-11px-antialised
    color: #ffcc00
    text-align: left

  Button
    id: closeButton
    !text: tr('Close')
    width: 64
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: modules.game_forge.toggle()

// ========== CLASSIFICATION TAB (TIER) ==========
ForgeClassificationTab < Panel
  id: classificationTab

  FlatPanel
    id: classInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: classInfoLabel
      anchors.fill: parent
      margin: 5 8 5 8
      text-wrap: true
      text-auto-resize: true
      !text: tr('Increase the classification (tier) of your item. Drag an item to the slot below. Higher tiers unlock more enchantment slots.')
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: classSourcePanel
    anchors.top: classInfoPanel.bottom
    anchors.left: parent.left
    width: 290
    height: 120
    margin-top: 6

    Label
      id: classSourceTitle
      !text: tr('Source Item')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Panel
      id: classItemContainer
      size: 36 36
      anchors.top: classSourceTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      image-source: /images/ui/slot
      image-size: 36 36

      ForgeItemSlot
        id: classSourceItem
        anchors.fill: parent

    Label
      id: classPlaceholder
      !text: tr('Drag item here')
      text-align: center
      anchors.top: classItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #666666

    Label
      id: classSourceTierLabel
      text-align: center
      anchors.top: classPlaceholder.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #c0c0c0

  UIWidget
    id: classArrow
    image-source: /images/ui/arrow_horizontal
    image-clip: 0 0 24 21
    size: 24 21
    anchors.verticalCenter: classSourcePanel.verticalCenter
    anchors.horizontalCenter: parent.horizontalCenter

  FlatPanel
    id: classResultPanel
    anchors.top: classSourcePanel.top
    anchors.right: parent.right
    width: 290
    height: 120

    Label
      id: classResultTitle
      !text: tr('Result')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Panel
      id: classResultItemContainer
      size: 36 36
      anchors.top: classResultTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      image-size: 36 36

      UIItem
        id: classResultItem
        size: 34 34
        anchors.centerIn: parent
        virtual: true

    Label
      id: classResultTierLabel
      text-align: center
      anchors.top: classResultItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: classResultMessage
      text-align: center
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 4
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: classActionPanel
    anchors.top: classSourcePanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6

    Label
      id: classMatTitle
      !text: tr('Below are the items needed to level up, you have the option to increase the chance of obtaining them by 20%%.')
      text-align: center
      text-wrap: true
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: 10
      margin-right: 10
      font: verdana-11px-antialised
      color: #aaaaaa

    ForgeRuneSlot
      id: classTierRuneSlot
      anchors.top: classMatTitle.bottom
      anchors.left: parent.left
      margin-top: 12
      margin-left: 18

    ForgeRuneSlot
      id: classProtRuneSlot
      anchors.top: classTierRuneSlot.top
      anchors.left: classTierRuneSlot.right
      margin-left: 10

    UIWidget
      id: classBonusButton
      size: 66 66
      image-source: /images/ui/20
      image-clip: 0 0 66 66
      image-color: #666666
      anchors.top: classTierRuneSlot.top
      anchors.left: classProtRuneSlot.right
      margin-left: 14

      $on:
        image-clip: 66 0 66 66
        image-color: #ffffff

      $pressed:
        image-color: #cccccc

    FlatLabel
      id: classBonusCostLabel
      text-align: center
      anchors.top: classBonusButton.bottom
      anchors.left: classBonusButton.left
      anchors.right: classBonusButton.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #ffcc00

    UIWidget
      id: classForgeArrow
      image-source: /images/ui/arrow_horizontal
      image-clip: 12 0 12 21
      size: 12 21
      anchors.verticalCenter: classBonusButton.verticalCenter
      anchors.left: classBonusButton.right
      margin-left: 16
      phantom: false

    Label
      id: classChanceLabel
      text-align: center
      anchors.verticalCenter: classBonusButton.verticalCenter
      anchors.left: classForgeArrow.right
      margin-left: 10
      width: 90
      font: verdana-11px-antialised
      color: #c0c0c0

    UIButton
      id: classForgeButton
      size: 128 66
      image-source: /images/game/imbuing/imbue_green
      image-clip: 0 0 128 66
      anchors.top: classTierRuneSlot.top
      anchors.right: parent.right
      margin-right: 18
      enabled: false

      $pressed:
        image-clip: 0 66 128 66

      $disabled:
        image-color: #666666

    FlatLabel
      id: classCostLabel
      text-align: center
      anchors.top: classForgeButton.bottom
      anchors.left: classForgeButton.left
      anchors.right: classForgeButton.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #ffcc00

    Label
      id: classMaterialLabel
      text-align: center
      anchors.top: classCostLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #c0c0c0
      text-wrap: true

    ProgressBar
      id: classProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 60
      margin-right: 60
      margin-bottom: 4
      height: 12
      background-color: #00aa00
      visible: false

// ========== ATTRIBUTES TAB (ENCHANTMENTS) ==========
ForgeAttributesTab < Panel
  id: attributesTab

  FlatPanel
    id: attrInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 52
    margin-top: 2

    Label
      id: attrInfoLabel
      anchors.fill: parent
      margin: 5 8 5 8
      text-wrap: true
      text-auto-resize: true
      !text: tr('Modify your item\'s attributes if it reaches level 1 or higher. You can choose a specific attribute to change or select one from a list. Selecting an attribute will cost more than selecting one randomly.')
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: attrItemPanel
    anchors.top: attrInfoPanel.bottom
    anchors.left: parent.left
    width: 290
    anchors.bottom: attrResultPanel.top
    margin-top: 6
    margin-bottom: 6

    Label
      id: attrItemTitle
      !text: tr('Source Item')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Panel
      id: attrItemContainer
      size: 36 36
      anchors.top: attrItemTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      image-source: /images/ui/slot
      image-size: 36 36

      ForgeItemSlot
        id: attrSourceItem
        anchors.fill: parent

    Label
      id: attrPlaceholder
      !text: tr('Drag item here')
      text-align: center
      anchors.top: attrItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #666666

    Label
      id: attrItemInfo
      text-align: center
      anchors.top: attrPlaceholder.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: attrEnchantTitle
      !text: tr('Current Enchantments')
      text-align: center
      anchors.top: attrItemInfo.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #dfdfdf

    ScrollableFlatPanel
      id: attrEnchantList
      anchors.top: attrEnchantTitle.bottom
      anchors.left: parent.left
      anchors.right: attrEnchantScroll.left
      anchors.bottom: parent.bottom
      margin: 4 0 6 8
      vertical-scrollbar: attrEnchantScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: attrEnchantScroll
      anchors.top: attrEnchantTitle.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-bottom: 6
      step: 16
      pixels-scroll: true

  FlatPanel
    id: attrActionPanel
    anchors.top: attrInfoPanel.bottom
    anchors.right: parent.right
    width: 360
    anchors.bottom: attrResultPanel.top
    margin-top: 6
    margin-bottom: 6

    Label
      id: attrActionTitle
      !text: tr('Enchantment Action')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Label
      id: attrActionLabel
      !text: tr('Action:')
      anchors.top: attrActionTitle.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: 12
      font: verdana-11px-antialised
      color: #c0c0c0

    ComboBox
      id: attrActionCombo
      anchors.top: attrActionLabel.top
      anchors.left: attrActionLabel.right
      anchors.right: parent.right
      margin-left: 8
      margin-right: 12
      margin-top: -2

    Label
      id: attrRuneTitle
      !text: tr('Required Rune:')
      anchors.top: attrActionCombo.bottom
      anchors.left: parent.left
      margin-top: 14
      margin-left: 12
      font: verdana-11px-antialised
      color: #c0c0c0

    ForgeRuneSlot
      id: attrRuneSlot
      anchors.top: attrRuneTitle.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 25

    Label
      id: attrCostTitle
      !text: tr('Total cost:')
      anchors.top: attrRuneTitle.top
      anchors.left: attrRuneSlot.right
      margin-left: 20
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: attrCostLabel
      anchors.top: attrCostTitle.bottom
      anchors.left: attrCostTitle.left
      anchors.right: parent.right
      margin-top: 4
      margin-right: 12
      font: verdana-11px-antialised
      color: #ffcc00

    Button
      id: attrExecuteButton
      !text: tr('Attribute!')
      width: 120
      anchors.top: attrCostLabel.bottom
      anchors.left: attrCostTitle.left
      margin-top: 8
      enabled: false

    FlatPanel
      id: attrDescPanel
      anchors.top: attrRuneSlot.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 8 8 8 8

      Label
        id: attrDescLabel
        anchors.fill: parent
        margin: 4
        text-wrap: true
        text-auto-resize: true
        font: verdana-11px-antialised
        color: #aaaaaa

    ProgressBar
      id: attrProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: attrDescPanel.top
      margin-left: 20
      margin-right: 20
      margin-bottom: 2
      height: 12
      background-color: #00aa00
      visible: false

  FlatPanel
    id: attrResultPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 26

    Label
      id: attrResultMessage
      text-align: center
      anchors.fill: parent
      margin: 4
      font: verdana-11px-antialised
      color: #c0c0c0

// ========== TOOLS TAB (UPGRADE) ==========
ForgeToolsTab < Panel
  id: toolsTab

  FlatPanel
    id: toolsInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: toolsInfoLabel
      anchors.fill: parent
      margin: 5 8 5 8
      text-wrap: true
      text-auto-resize: true
      !text: tr('Upgrade your equipment to improve its stats. Higher upgrade levels have lower chances of success. Failed upgrades may downgrade the item.')
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: toolsSourcePanel
    anchors.top: toolsInfoPanel.bottom
    anchors.left: parent.left
    width: 290
    height: 120
    margin-top: 6

    Label
      id: toolsSourceTitle
      !text: tr('Source Item')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Panel
      id: toolsItemContainer
      size: 36 36
      anchors.top: toolsSourceTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      image-source: /images/ui/slot
      image-size: 36 36

      ForgeItemSlot
        id: toolsSourceItem
        anchors.fill: parent

    Label
      id: toolsPlaceholder
      !text: tr('Drag item here')
      text-align: center
      anchors.top: toolsItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #666666

    Label
      id: toolsSourceLevelLabel
      text-align: center
      anchors.top: toolsPlaceholder.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #c0c0c0

  UIWidget
    id: toolsArrow
    image-source: /images/ui/arrow_horizontal
    image-clip: 0 0 24 21
    size: 24 21
    anchors.verticalCenter: toolsSourcePanel.verticalCenter
    anchors.horizontalCenter: parent.horizontalCenter

  FlatPanel
    id: toolsResultPanel
    anchors.top: toolsSourcePanel.top
    anchors.right: parent.right
    width: 290
    height: 120

    Label
      id: toolsResultTitle
      !text: tr('Result')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      font: verdana-11px-antialised
      color: #dfdfdf

    Panel
      id: toolsResultItemContainer
      size: 36 36
      anchors.top: toolsResultTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      image-size: 36 36

      UIItem
        id: toolsResultItem
        size: 34 34
        anchors.centerIn: parent
        virtual: true

    Label
      id: toolsResultLevelLabel
      text-align: center
      anchors.top: toolsResultItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #c0c0c0

    Label
      id: toolsResultMessage
      text-align: center
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 4
      font: verdana-11px-antialised
      color: #c0c0c0

  FlatPanel
    id: toolsActionPanel
    anchors.top: toolsSourcePanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6

    Label
      id: toolsMatTitle
      !text: tr('Below are the items needed to level up, you have the option to increase the chance of obtaining them by 20%%.')
      text-align: center
      text-wrap: true
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: 10
      margin-right: 10
      font: verdana-11px-antialised
      color: #aaaaaa

    ForgeRuneSlot
      id: toolsUpgradeRuneSlot
      anchors.top: toolsMatTitle.bottom
      anchors.left: parent.left
      margin-top: 12
      margin-left: 18

    ForgeRuneSlot
      id: toolsProtRuneSlot
      anchors.top: toolsUpgradeRuneSlot.top
      anchors.left: toolsUpgradeRuneSlot.right
      margin-left: 10

    UIWidget
      id: toolsBonusButton
      size: 66 66
      image-source: /images/ui/20
      image-clip: 0 0 66 66
      image-color: #666666
      anchors.top: toolsUpgradeRuneSlot.top
      anchors.left: toolsProtRuneSlot.right
      margin-left: 14

      $on:
        image-clip: 66 0 66 66
        image-color: #ffffff

      $pressed:
        image-color: #cccccc

    FlatLabel
      id: toolsBonusCostLabel
      text-align: center
      anchors.top: toolsBonusButton.bottom
      anchors.left: toolsBonusButton.left
      anchors.right: toolsBonusButton.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #ffcc00

    UIWidget
      id: toolsForgeArrow
      image-source: /images/ui/arrow_horizontal
      image-clip: 12 0 12 21
      size: 12 21
      anchors.verticalCenter: toolsBonusButton.verticalCenter
      anchors.left: toolsBonusButton.right
      margin-left: 16
      phantom: false

    Label
      id: toolsChanceLabel
      text-align: center
      anchors.verticalCenter: toolsBonusButton.verticalCenter
      anchors.left: toolsForgeArrow.right
      margin-left: 10
      width: 90
      font: verdana-11px-antialised
      color: #c0c0c0

    UIButton
      id: toolsForgeButton
      size: 128 66
      image-source: /images/game/imbuing/imbue_green
      image-clip: 0 0 128 66
      anchors.top: toolsUpgradeRuneSlot.top
      anchors.right: parent.right
      margin-right: 18
      enabled: false

      $pressed:
        image-clip: 0 66 128 66

      $disabled:
        image-color: #666666

    FlatLabel
      id: toolsCostLabel
      text-align: center
      anchors.top: toolsForgeButton.bottom
      anchors.left: toolsForgeButton.left
      anchors.right: toolsForgeButton.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #ffcc00

    Label
      id: toolsMaterialLabel
      text-align: center
      anchors.top: toolsCostLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: verdana-11px-antialised
      color: #c0c0c0
      text-wrap: true

    ProgressBar
      id: toolsProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 60
      margin-right: 60
      margin-bottom: 4
      height: 12
      background-color: #00aa00
      visible: false

ForgeWindow
