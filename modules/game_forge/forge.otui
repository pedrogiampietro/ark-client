// ============================================================
// FORGE ITEM MODULE - UI Definitions
// ============================================================

// ---- Fragment slot widget (used in Classification & Tools) --
ForgeFragmentSlot < Panel
  size: 90 126

  Panel
    id: slotBg
    size: 76 76
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    background-color: #1b1b1b
    border-width: 1
    border-color: #585858

    UIItem
      id: runeItem
      size: 52 52
      anchors.centerIn: parent
      virtual: true

  Panel
    id: runeCountBox
    height: 24
    anchors.top: slotBg.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    background-color: #111111
    border-width: 1
    border-color: #4f4f4f

    Label
      id: runeCount
      anchors.fill: parent
      text-align: center
      font: verdana-11px-antialised
      color: #d0d0d0

  Label
    id: runeLabel
    anchors.top: runeCountBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 16
    text-align: center
    font: verdana-11px-antialised
    color: #bcbcbc

// ---- Enchantment slot (smaller, used in Attributes tab) ----
ForgeAttrSlot < Panel
  size: 82 122

  Panel
    id: slotBg
    size: 70 70
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    background-color: #1b1b1b
    border-width: 1
    border-color: #585858

    UIItem
      id: runeItem
      size: 48 48
      anchors.centerIn: parent
      virtual: true

  Panel
    id: runeCountBox
    height: 22
    anchors.top: slotBg.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    background-color: #111111
    border-width: 1
    border-color: #4f4f4f

    Label
      id: runeCount
      anchors.fill: parent
      text-align: center
      font: verdana-11px-antialised
      color: #d0d0d0

  Label
    id: runeLabel
    anchors.top: runeCountBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 13
    text-align: center
    font: verdana-11px-antialised
    color: #bcbcbc

// ---- Shared visual blocks ----------------------------------
ForgeSectionPanel < Panel
  background-color: #2b2b2b
  border-width: 1
  border-color: #676767

ForgeInnerPanel < Panel
  background-color: #202020
  border-width: 1
  border-color: #4a4a4a

// ---- Item preview slot (Source / Result panels) -------------
ForgeItemSlot < UIItem
  size: 34 34
  padding: 1
  border-width: 0
  &selectable: true
  &canDrop: true

  $disabled:
    color: #646464

// ---- Single enchantment row (Attributes tab list) ----------
ForgeEnchantRow < Panel
  height: 20

  Label
    id: slotIndex
    width: 20
    text-align: right
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-antialised
    color: #506080

  Label
    id: enchantName
    anchors.left: slotIndex.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-antialised
    color: #80d4b0

// ============================================================
// MAIN WINDOW
// ============================================================
ForgeWindow < MainWindow
  id: forgeWindow
  !text: tr('Forge Item')
  size: 742 512
  @onEscape: modules.game_forge.toggle()

  TabBar
    id: forgeTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 4
    margin-right: 4

  Panel
    id: forgeContent
    anchors.top: forgeTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: forgeBottomBar.top
    margin-top: 6
    margin-left: 4
    margin-right: 4
    margin-bottom: 6
    background-color: #1f1f1f
    border-width: 1
    border-color: #5e5e5e

  // Bottom bar: styled balance panel + close button
  ForgeSectionPanel
    id: forgeBottomBar
    height: 34
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 0

    // Balance pill (left side)
    Panel
      id: forgeBalancePill
      height: 24
      width: 180
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      background-color: #171717
      border-width: 1
      border-color: #4f4f4f

      Label
        !text: tr('Balance')
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        font: verdana-11px-antialised
        color: #a7a7a7

      UIWidget
        id: forgeBalanceCoin
        size: 16 16
        image-source: /images/ui/crystal_coin
        image-size: 16 16
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 66

      Label
        id: forgeBalanceLabel
        anchors.left: forgeBalanceCoin.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        margin-right: 4
        font: verdana-11px-antialised
        color: #ffd700
        text-align: left

    // Vertical separator
    UIWidget
      id: forgeBalanceSep
      width: 1
      height: 22
      background-color: #5a5a5a
      anchors.left: forgeBalancePill.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8

    Button
      id: closeButton
      !text: tr('Close')
      width: 70
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      @onClick: modules.game_forge.toggle()


// ============================================================
// CLASSIFICATION TAB (TIER)
// ============================================================
ForgeClassificationTab < Panel
  id: classificationTab

  // -- Description banner --
  ForgeSectionPanel
    id: classInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: classInfoLabel
      anchors.fill: parent
      margin: 5 12 5 12
      text-wrap: true
      text-auto-resize: false
      !text: tr('Increase the classification (tier) of your item. Drag an item to the slot below. Higher tiers unlock more enchantment slots.')
      font: verdana-11px-antialised
      color: #c6c6c6

  // -- Source / Result row --
  Panel
    id: classPreviewRow
    height: 138
    anchors.top: classInfoPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    background-color: #242424
    border-width: 1
    border-color: #585858

    // Source panel
    ForgeInnerPanel
      id: classSourcePanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 238
      margin-left: 8
      margin-top: 8
      margin-bottom: 8

      Label
        id: classSourceTitle
        !text: tr('Source Item')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #e0e0e0

      Panel
        id: classItemContainer
        size: 52 52
        anchors.top: classSourceTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        ForgeItemSlot
          id: classSourceItem
          size: 48 48
          anchors.centerIn: parent

      Label
        id: classPlaceholder
        !text: tr('Drag item here')
        text-align: center
        anchors.top: classItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 3
        font: verdana-11px-antialised
        color: #8b8b8b

      Label
        id: classSourceTierLabel
        text-align: center
        anchors.top: classPlaceholder.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 1
        font: verdana-11px-antialised
        color: #bfbfbf

    // Arrow
    UIWidget
      id: classArrow
      image-source: /images/ui/arrow_horizontal
      image-clip: 0 0 24 21
      size: 24 21
      anchors.verticalCenter: classSourcePanel.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter

    // Result panel
    ForgeInnerPanel
      id: classResultPanel
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 238
      margin-right: 8
      margin-top: 8
      margin-bottom: 8

      Label
        id: classResultTitle
        !text: tr('Result')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #e0e0e0

      Panel
        id: classResultItemContainer
        size: 52 52
        anchors.top: classResultTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        UIItem
          id: classResultItem
          size: 48 48
          anchors.centerIn: parent
          virtual: true

      Label
        id: classResultTierLabel
        text-align: center
        anchors.top: classResultItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        font: verdana-11px-antialised
        color: #d0d0d0

      Label
        id: classResultMessage
        text-align: center
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 5
        font: verdana-11px-antialised
        color: #d0d0d0

  // -- Materials area --
  ForgeSectionPanel
    id: classActionPanel
    anchors.top: classPreviewRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6

    // Section title
    Label
      id: classMatSectionTitle
      !text: tr('Required Materials')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #e8e8e8

    // Sub-hint
    Label
      id: classMatTitle
      !text: tr('You can increase the success chance by 20%% using the bonus option.')
      text-align: center
      text-wrap: true
      height: 14
      anchors.top: classMatSectionTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 16
      margin-right: 16
      font: verdana-11px-antialised
      color: #a6a6a6

    // Materials + action row
    Panel
      id: classActionRow
      height: 146
      anchors.top: classMatTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      background-color: #0a0f14
      border-width: 1
      border-color: #2d4958

      Panel
        id: classActionGlowTop
        height: 1
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 8
        margin-right: 8
        background-color: #3bc8f5

      Panel
        id: classActionGlowBottom
        height: 1
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 8
        margin-right: 8
        background-color: #17323f

      Panel
        id: classLeftEdgeRail
        width: 2
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-top: 8
        margin-bottom: 8
        margin-left: 6
        background-color: #2fa6d8

      Panel
        id: classRightEdgeRail
        width: 2
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-top: 8
        margin-bottom: 8
        margin-right: 6
        background-color: #2fa6d8

      // ── Left: fragment slots ──────────────────────────────
      Panel
        id: classSlotsGroup
        width: 214
        height: 130
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 12
        margin-top: 8
        background-color: #091117
        border-width: 1
        border-color: #2f5a6a

        Label
          !text: tr('Material Nodes')
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 3
          text-align: center
          font: verdana-11px-antialised
          color: #70cbe8

        ForgeFragmentSlot
          id: classTierRuneSlot
          anchors.top: parent.top
          anchors.left: parent.left
          margin-top: 16
          margin-left: 12

        ForgeFragmentSlot
          id: classProtRuneSlot
          anchors.top: parent.top
          anchors.left: classTierRuneSlot.right
          margin-top: 16
          margin-left: 10

        Panel
          height: 1
          anchors.left: classTierRuneSlot.left
          anchors.right: classProtRuneSlot.right
          anchors.bottom: parent.bottom
          margin-bottom: 6
          background-color: #244655

      // ── Vertical separator ────────────────────────────────
      UIWidget
        id: classSlotSep
        width: 14
        background-color: #0b141a
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: classSlotsGroup.right
        margin-left: 6
        margin-top: 8
        margin-bottom: 8
        border-width: 1
        border-color: #244c5b

        Panel
          width: 2
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 8
          margin-bottom: 8
          background-color: #39c7ef

      // ── Right: bonus + chance + forge panel ───────────────
      ForgeInnerPanel
        id: classRightPanel
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: classSlotSep.right
        anchors.right: parent.right
        margin-left: 6
        margin-right: 12
        margin-top: 8
        margin-bottom: 8
        background-color: #070f14
        border-color: #285060

        // Telemetry lane (inverted order for a different visual rhythm)
        Panel
          id: classBonusRow
          height: 38
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 7
          margin-left: 8
          margin-right: 8
          background-color: #101922
          border-width: 1
          border-color: #2c5b6b

          Panel
            width: 1
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.left: parent.left
            margin-left: 150
            background-color: #1f4452

          // Chance on the left
          Panel
            id: classChancePanel
            width: 138
            height: 28
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 6
            background-color: #0a151c
            border-width: 1
            border-color: #357286

            Label
              id: classChanceLabel
              anchors.fill: parent
              text-align: center
              font: verdana-11px-antialised
              color: #79ffc2
              text-wrap: true

          // Arrow connector
          UIWidget
            id: classForgeArrow
            image-source: /images/ui/arrow_horizontal
            image-clip: 12 0 12 21
            size: 12 21
            anchors.left: classChancePanel.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 8
            image-color: #47c8e9
            phantom: false

          // Bonus extra cost now near the action toggle
          Panel
            id: classBonusCostRow
            width: 86
            height: 24
            anchors.right: classBonusButton.left
            anchors.verticalCenter: parent.verticalCenter
            margin-right: 8
            background-color: #0a1218
            border-width: 1
            border-color: #2f5d6b

            UIWidget
              image-source: /images/ui/crystal_coin
              image-size: 16 16
              size: 16 16
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 4

            Label
              id: classBonusCostLabel
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 25
              width: 56
              font: verdana-11px-antialised
              color: #77d6ff

          // +20% toggle on far right
          UIWidget
            id: classBonusButton
            size: 32 32
            image-source: /images/ui/20
            image-clip: 0 0 66 66
            image-size: 32 32
            image-color: #cccccc
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-right: 7

            $on:
              image-clip: 66 0 66 66
              image-color: #ffffff

            $pressed:
              image-color: #aaaaaa

        // Command deck with stacked cost + action button
        Panel
          id: classForgeRow
          anchors.top: classBonusRow.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin-top: 7
          margin-left: 8
          margin-right: 8
          margin-bottom: 7
          background-color: #0a1218
          border-width: 1
          border-color: #27515f

          Panel
            id: classForgeCenter
            width: 182
            height: 84
            anchors.centerIn: parent

            Panel
              height: 1
              anchors.top: parent.top
              anchors.left: parent.left
              anchors.right: parent.right
              background-color: #326272

            // Cost strip on top
            Panel
              id: classCostPill
              width: 182
              height: 28
              anchors.top: parent.top
              anchors.horizontalCenter: parent.horizontalCenter
              background-color: #0b171f
              border-width: 1
              border-color: #2d5f71

              Label
                !text: tr('Forge Cost')
                anchors.left: parent.left
                anchors.verticalCenter: parent.verticalCenter
                margin-left: 8
                font: verdana-11px-antialised
                color: #9ab6c0

              UIWidget
                id: classCostCoin
                size: 18 18
                image-source: /images/ui/crystal_coin
                image-size: 18 18
                anchors.left: parent.left
                anchors.verticalCenter: parent.verticalCenter
                margin-left: 76

              Label
                id: classCostLabel
                anchors.left: classCostCoin.right
                anchors.right: parent.right
                anchors.verticalCenter: parent.verticalCenter
                margin-left: 4
                margin-right: 6
                height: 16
                font: verdana-11px-antialised
                color: #7cdcff
                text-align: left

            // Action button below
            UIButton
              id: classForgeButton
              size: 102 52
              image-source: /images/game/imbuing/imbue_empty
              image-clip: 0 0 128 66
              anchors.bottom: parent.bottom
              anchors.horizontalCenter: parent.horizontalCenter
              enabled: false
              image-color: #4ad8ff

              $pressed:
                image-clip: 0 66 128 66

              $disabled:
                image-color: #2a4a57

    // Status label
    Panel
      id: classMaterialStatus
      width: 348
      height: 20
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: classProgressBar.top
      margin-bottom: 4
      background-color: #091319
      border-width: 1
      border-color: #2a5968

      Panel
        width: 1
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-left: 22
        background-color: #2d6072

      Label
        !text: tr('SYS')
        width: 20
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 1
        text-align: center
        font: verdana-11px-antialised
        color: #78d8ff

      Label
        id: classMaterialLabel
        text-align: left
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 28
        margin-right: 8
        font: verdana-11px-antialised
        color: #d0d0d0
        text-wrap: true

    ProgressBar
      id: classProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 104
      margin-right: 104
      margin-bottom: 6
      height: 10
      background-color: #2f7d95
      visible: false


// ============================================================
// ATTRIBUTES TAB (ENCHANTMENTS)
// ============================================================
ForgeAttributesTab < Panel
  id: attributesTab

  // -- Info banner --
  ForgeSectionPanel
    id: attrInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: attrInfoLabel
      anchors.fill: parent
      margin: 5 8 5 8
      text-wrap: true
      text-auto-resize: false
      !text: tr('Modify your item\'s attributes. Drag an item to the slot. Selecting a specific attribute costs more than a random one.')
      font: verdana-11px-antialised
      color: #c6c6c6

  // -- Left column: source item + enchantments list --
  ForgeSectionPanel
    id: attrItemPanel
    anchors.top: attrInfoPanel.bottom
    anchors.left: parent.left
    width: 226
    anchors.bottom: attrResultPanel.top
    margin-top: 6
    margin-bottom: 6

    Label
      id: attrItemTitle
      !text: tr('Source Item')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      font: verdana-11px-antialised
      color: #e0e0e0

    Panel
      id: attrItemContainer
      size: 52 52
      anchors.top: attrItemTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
      image-source: /images/ui/slot
      image-size: 52 52

      ForgeItemSlot
        id: attrSourceItem
        size: 48 48
        anchors.centerIn: parent

    Label
      id: attrPlaceholder
      !text: tr('Drag item here')
      text-align: center
      anchors.top: attrItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      font: verdana-11px-antialised
      color: #8b8b8b

    Label
      id: attrItemInfo
      text-align: center
      anchors.top: attrPlaceholder.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #c4c4c4

    Label
      id: attrEnchantTitle
      !text: tr('Current Enchantments')
      text-align: center
      anchors.top: attrItemInfo.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #e8e8e8

    UIWidget
      id: attrEnchantDivider
      height: 1
      background-color: #5a5a5a
      anchors.top: attrEnchantTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 8
      margin-right: 8

    ScrollableFlatPanel
      id: attrEnchantList
      anchors.top: attrEnchantDivider.bottom
      anchors.left: parent.left
      anchors.right: attrEnchantScroll.left
      anchors.bottom: parent.bottom
      margin: 4 0 6 8
      vertical-scrollbar: attrEnchantScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: attrEnchantScroll
      anchors.top: attrEnchantDivider.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-bottom: 6
      step: 16
      pixels-scroll: true

  // -- Right column: action selector + fragment + cost --
  ForgeSectionPanel
    id: attrActionPanel
    anchors.top: attrInfoPanel.bottom
    anchors.right: parent.right
    width: 478
    anchors.bottom: attrResultPanel.top
    margin-top: 6
    margin-bottom: 6

    Label
      id: attrActionTitle
      !text: tr('Enchantment Action')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      font: verdana-11px-antialised
      color: #e8e8e8

    UIWidget
      id: attrActionDivider
      height: 1
      background-color: #5a5a5a
      anchors.top: attrActionTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 8
      margin-right: 8

    Label
      id: attrActionLabel
      !text: tr('Action:')
      anchors.top: attrActionDivider.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: 12
      font: verdana-11px-antialised
      color: #c4c4c4

    ComboBox
      id: attrActionCombo
      anchors.top: attrActionLabel.top
      anchors.left: attrActionLabel.right
      anchors.right: parent.right
      margin-left: 8
      margin-right: 12
      margin-top: -2

    Panel
      id: attrReplacePanel
      height: 90
      anchors.top: attrActionCombo.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      background-color: #1f1f1f
      border-width: 1
      border-color: #4e4e4e

      Label
        id: attrReplaceSlotLabel
        !text: tr('Slot:')
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 12
        font: verdana-11px-antialised
        color: #c4c4c4
        visible: false

      ComboBox
        id: attrReplaceSlotCombo
        anchors.top: attrReplaceSlotLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 12
        margin-right: 12
        visible: false

      Label
        id: attrReplaceAttrLabel
        !text: tr('New attribute:')
        anchors.top: attrReplaceSlotCombo.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        margin-left: 12
        margin-right: 12
        font: verdana-11px-antialised
        color: #c4c4c4
        visible: false

      ComboBox
        id: attrReplaceAttrCombo
        anchors.top: attrReplaceAttrLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 12
        margin-right: 12
        visible: false

    // Fragment slot + cost in same row
    Panel
      id: attrMaterialRow
      height: 130
      anchors.top: attrReplacePanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4

      Label
        id: attrRuneTitle
        !text: tr('Required Fragment (x100):')
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 12
        font: verdana-11px-antialised
        color: #d3d3d3

      ForgeAttrSlot
        id: attrRuneSlot
        anchors.top: attrRuneTitle.bottom
        anchors.left: parent.left
        margin-top: 4
        margin-left: 12

      Panel
        id: attrCostGroup
        width: 160
        height: 60
        anchors.top: attrRuneTitle.bottom
        anchors.left: attrRuneSlot.right
        margin-left: 20
        margin-top: 10
        background-color: #1a1a1a
        border-width: 1
        border-color: #4f4f4f

        Label
          id: attrCostTitle
          !text: tr('Total cost:')
          anchors.top: parent.top
          anchors.left: parent.left
          font: verdana-11px-antialised
          color: #d0d0d0

        Panel
          id: attrCostIconRow
          height: 24
          anchors.top: attrCostTitle.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 4

          Panel
            image-source: /images/ui/crystal_coin
            image-size: 20 20
            size: 20 20
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter

          Label
            id: attrCostLabel
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 26
            width: 120
            font: verdana-11px-antialised
            color: #ffd700

      Button
        id: attrExecuteButton
        !text: tr('Apply!')
        width: 120
        anchors.top: attrRuneTitle.bottom
        anchors.right: parent.right
        margin-top: 8
        margin-right: 12
        enabled: false

    ProgressBar
      id: attrProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: attrDescPanel.top
      margin-left: 20
      margin-right: 20
      margin-bottom: 4
      height: 10
      background-color: #4a8d45
      visible: false

    ForgeInnerPanel
      id: attrDescPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 4 8 8 8

      Label
        id: attrDescLabel
        anchors.fill: parent
        margin: 5
        text-wrap: true
        text-auto-resize: true
        font: verdana-11px-antialised
        color: #b8b8b8

  // -- Result bar (bottom) --
  ForgeSectionPanel
    id: attrResultPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 24

    Label
      id: attrResultMessage
      text-align: center
      anchors.fill: parent
      margin: 4
      font: verdana-11px-antialised
      color: #d0d0d0


// ============================================================
// TOOLS TAB (UPGRADE)
// ============================================================
ForgeToolsTab < Panel
  id: toolsTab

  // -- Description banner --
  ForgeSectionPanel
    id: toolsInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: toolsInfoLabel
      anchors.fill: parent
      margin: 5 12 5 12
      text-wrap: true
      text-auto-resize: false
      !text: tr('Upgrade your equipment to improve its stats. Higher upgrade levels have lower success chance. Failed upgrades may downgrade the item.')
      font: verdana-11px-antialised
      color: #c6c6c6

  // -- Source / Result row --
  Panel
    id: toolsPreviewRow
    height: 138
    anchors.top: toolsInfoPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    background-color: #242424
    border-width: 1
    border-color: #585858

    ForgeInnerPanel
      id: toolsSourcePanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 238
      margin-left: 8
      margin-top: 8
      margin-bottom: 8

      Label
        id: toolsSourceTitle
        !text: tr('Source Item')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #e0e0e0

      Panel
        id: toolsItemContainer
        size: 52 52
        anchors.top: toolsSourceTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        ForgeItemSlot
          id: toolsSourceItem
          size: 48 48
          anchors.centerIn: parent

      Label
        id: toolsPlaceholder
        !text: tr('Drag item here')
        text-align: center
        anchors.top: toolsItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 3
        font: verdana-11px-antialised
        color: #8b8b8b

      Label
        id: toolsSourceLevelLabel
        text-align: center
        anchors.top: toolsPlaceholder.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 1
        font: verdana-11px-antialised
        color: #bfbfbf

    UIWidget
      id: toolsArrow
      image-source: /images/ui/arrow_horizontal
      image-clip: 0 0 24 21
      size: 24 21
      anchors.verticalCenter: toolsSourcePanel.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter

    ForgeInnerPanel
      id: toolsResultPanel
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 238
      margin-right: 8
      margin-top: 8
      margin-bottom: 8

      Label
        id: toolsResultTitle
        !text: tr('Result')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #e0e0e0

      Panel
        id: toolsResultItemContainer
        size: 52 52
        anchors.top: toolsResultTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        UIItem
          id: toolsResultItem
          size: 48 48
          anchors.centerIn: parent
          virtual: true

      Label
        id: toolsResultLevelLabel
        text-align: center
        anchors.top: toolsResultItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        font: verdana-11px-antialised
        color: #d0d0d0

      Label
        id: toolsResultMessage
        text-align: center
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 5
        font: verdana-11px-antialised
        color: #d0d0d0

  // -- Materials area --
  ForgeSectionPanel
    id: toolsActionPanel
    anchors.top: toolsPreviewRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6

    Label
      id: toolsMatSectionTitle
      !text: tr('Required Materials')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #e8e8e8

    Label
      id: toolsMatTitle
      !text: tr('You can increase the success chance by 20%% using the bonus option.')
      text-align: center
      text-wrap: true
      height: 14
      anchors.top: toolsMatSectionTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 16
      margin-right: 16
      font: verdana-11px-antialised
      color: #a6a6a6

    Panel
      id: toolsActionRow
      height: 132
      anchors.top: toolsMatTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      background-color: #0f1419
      border-width: 1
      border-color: #2f5a66

      Panel
        id: toolsActionGlowTop
        height: 1
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 8
        margin-right: 8
        background-color: #4fd4ff

      Panel
        id: toolsActionGlowBottom
        height: 1
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 8
        margin-right: 8
        background-color: #1d3a45

      // ── Left: fragment slots ──────────────────────────────
      Panel
        id: toolsSlotsGroup
        width: 190
        height: 116
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 10
        margin-top: 6
        background-color: #0b1014
        border-width: 1
        border-color: #315967

        ForgeFragmentSlot
          id: toolsUpgradeRuneSlot
          anchors.top: parent.top
          anchors.left: parent.left
          margin-top: 4
          margin-left: 8

        ForgeFragmentSlot
          id: toolsProtRuneSlot
          anchors.top: parent.top
          anchors.left: toolsUpgradeRuneSlot.right
          margin-top: 4
          margin-left: 8

      // ── Vertical separator ────────────────────────────────
      UIWidget
        id: toolsSlotSep
        width: 2
        background-color: #2e8ca8
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: toolsSlotsGroup.right
        margin-left: 8
        margin-top: 6
        margin-bottom: 6

      // ── Right: bonus + chance + forge panel ───────────────
      ForgeInnerPanel
        id: toolsRightPanel
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: toolsSlotSep.right
        anchors.right: parent.right
        margin-left: 8
        margin-right: 10
        margin-top: 6
        margin-bottom: 6
        background-color: #0a1014
        border-color: #2b5663

        // Top row: +20% toggle and chance
        Panel
          id: toolsBonusRow
          height: 40
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 6
          margin-left: 10
          margin-right: 10
          background-color: #111a20
          border-width: 1
          border-color: #2f5d6b

          UIWidget
            id: toolsBonusButton
            size: 34 34
            image-source: /images/ui/20
            image-clip: 0 0 66 66
            image-size: 34 34
            image-color: #cccccc
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5

            $on:
              image-clip: 66 0 66 66
              image-color: #ffffff

            $pressed:
              image-color: #aaaaaa

          Panel
            id: toolsBonusCostRow
            width: 84
            height: 24
            anchors.left: toolsBonusButton.right
            anchors.verticalCenter: toolsBonusButton.verticalCenter
            margin-left: 8
            background-color: #0a1116
            border-width: 1
            border-color: #2f5d6b

            UIWidget
              image-source: /images/ui/crystal_coin
              image-size: 16 16
              size: 16 16
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 3

            Label
              id: toolsBonusCostLabel
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 24
              width: 54
              font: verdana-11px-antialised
              color: #7ed7ff

          UIWidget
            id: toolsForgeArrow
            image-source: /images/ui/arrow_horizontal
            image-clip: 12 0 12 21
            size: 12 21
            anchors.left: toolsBonusCostRow.right
            anchors.verticalCenter: toolsBonusButton.verticalCenter
            margin-left: 6
            image-color: #42b7d9
            phantom: false

          Panel
            id: toolsChancePanel
            width: 146
            height: 30
            anchors.right: parent.right
            anchors.verticalCenter: toolsBonusButton.verticalCenter
            margin-right: 4
            background-color: #0b141a
            border-width: 1
            border-color: #347589

            Label
              id: toolsChanceLabel
              anchors.fill: parent
              text-align: center
              font: verdana-11px-antialised
              color: #76ffb8
              text-wrap: true

        Panel
          id: toolsForgeRow
          anchors.top: toolsBonusRow.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin-top: 6
          margin-bottom: 6
          background-color: #0b1115
          border-width: 1
          border-color: #2b5562

          Panel
            id: toolsForgeCenter
            width: 242
            height: 56
            anchors.centerIn: parent

            Panel
              id: toolsCostPill
              width: 122
              height: 52
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              background-color: #0a1015
              border-width: 1
              border-color: #2f5d6b

              Label
                !text: tr('Forge Cost')
                anchors.left: parent.left
                anchors.top: parent.top
                margin-left: 10
                margin-top: 5
                font: verdana-11px-antialised
                color: #9bb1ba

              UIWidget
                id: toolsCostCoin
                size: 22 22
                image-source: /images/ui/crystal_coin
                image-size: 22 22
                anchors.left: parent.left
                anchors.bottom: parent.bottom
                margin-left: 10
                margin-bottom: 7

              Label
                id: toolsCostLabel
                anchors.left: toolsCostCoin.right
                anchors.bottom: toolsCostCoin.bottom
                anchors.right: parent.right
                margin-left: 5
                margin-right: 6
                height: 20
                font: verdana-11px-antialised
                color: #7ed7ff
                text-align: left

            UIButton
              id: toolsForgeButton
              size: 112 56
              image-source: /images/game/imbuing/imbue_empty
              image-clip: 0 0 128 66
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              enabled: false
              image-color: #47d8ff

              $pressed:
                image-clip: 0 66 128 66

              $disabled:
                image-color: #284653

      Panel
        id: toolsMaterialStatus
        width: 328
        height: 18
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: toolsProgressBar.top
        margin-bottom: 4
        background-color: #0a1217
        border-width: 1
        border-color: #2d5b69

        Label
          id: toolsMaterialLabel
          text-align: center
          anchors.fill: parent
          font: verdana-11px-antialised
          color: #d0d0d0
          text-wrap: true

    ProgressBar
      id: toolsProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 98
      margin-right: 98
      margin-bottom: 6
      height: 10
      background-color: #2f7084
      visible: false


// ============================================================
// INSTANTIATE WINDOW
// ============================================================
ForgeWindow
