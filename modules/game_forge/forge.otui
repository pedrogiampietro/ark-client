// ============================================================
// FORGE ITEM MODULE - UI Definitions
// ============================================================

// ---- Fragment slot widget (used in Classification & Tools) --
ForgeFragmentSlot < Panel
  size: 82 122

  Panel
    id: slotBg
    size: 70 70
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    background-color: #0e1320
    border-width: 1
    border-color: #2d4060

    UIItem
      id: runeItem
      size: 48 48
      anchors.centerIn: parent
      virtual: true

  Panel
    id: runeCountBox
    height: 22
    anchors.top: slotBg.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    background-color: #080c14
    border-width: 1
    border-color: #1e2d45

    Label
      id: runeCount
      anchors.fill: parent
      text-align: center
      font: verdana-11px-antialised
      color: #a0b8d0

  Label
    id: runeLabel
    anchors.top: runeCountBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 13
    text-align: center
    font: verdana-11px-antialised
    color: #6680aa

// ---- Enchantment slot (smaller, used in Attributes tab) ----
ForgeAttrSlot < Panel
  size: 82 122

  Panel
    id: slotBg
    size: 70 70
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    background-color: #0e1320
    border-width: 1
    border-color: #2d4060

    UIItem
      id: runeItem
      size: 48 48
      anchors.centerIn: parent
      virtual: true

  Panel
    id: runeCountBox
    height: 22
    anchors.top: slotBg.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    background-color: #080c14
    border-width: 1
    border-color: #1e2d45

    Label
      id: runeCount
      anchors.fill: parent
      text-align: center
      font: verdana-11px-antialised
      color: #a0b8d0

  Label
    id: runeLabel
    anchors.top: runeCountBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 13
    text-align: center
    font: verdana-11px-antialised
    color: #6680aa

// ---- Item preview slot (Source / Result panels) -------------
ForgeItemSlot < UIItem
  size: 34 34
  padding: 1
  border-width: 0
  &selectable: true
  &canDrop: true

  $disabled:
    color: #646464

// ---- Single enchantment row (Attributes tab list) ----------
ForgeEnchantRow < Panel
  height: 20

  Label
    id: slotIndex
    width: 20
    text-align: right
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-antialised
    color: #506080

  Label
    id: enchantName
    anchors.left: slotIndex.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-antialised
    color: #80d4b0

// ============================================================
// MAIN WINDOW
// ============================================================
ForgeWindow < MainWindow
  id: forgeWindow
  !text: tr('Forge Item')
  size: 720 590
  @onEscape: modules.game_forge.toggle()

  TabBar
    id: forgeTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  Panel
    id: forgeContent
    anchors.top: forgeTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: forgeBottomBar.top
    margin-top: 4
    margin-bottom: 4

  // Bottom bar: styled balance panel + close button
  FlatPanel
    id: forgeBottomBar
    height: 34
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 0

    // Balance pill (left side)
    Panel
      id: forgeBalancePill
      height: 24
      width: 180
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      background-color: #070b12
      border-width: 1
      border-color: #1e2d45

      Label
        !text: tr('Balance')
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        font: verdana-11px-antialised
        color: #506070

      UIWidget
        id: forgeBalanceCoin
        size: 16 16
        image-source: /images/ui/crystal_coin
        image-size: 16 16
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 66

      Label
        id: forgeBalanceLabel
        anchors.left: forgeBalanceCoin.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        margin-right: 4
        font: verdana-11px-antialised
        color: #ffd700
        text-align: left

    // Vertical separator
    UIWidget
      id: forgeBalanceSep
      width: 1
      height: 22
      background-color: #1e2d45
      anchors.left: forgeBalancePill.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8

    Button
      id: closeButton
      !text: tr('Close')
      width: 70
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      @onClick: modules.game_forge.toggle()


// ============================================================
// CLASSIFICATION TAB (TIER)
// ============================================================
ForgeClassificationTab < Panel
  id: classificationTab

  // -- Description banner --
  FlatPanel
    id: classInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: classInfoLabel
      anchors.fill: parent
      margin: 5 12 5 12
      text-wrap: true
      text-auto-resize: false
      !text: tr('Increase the classification (tier) of your item. Drag an item to the slot below. Higher tiers unlock more enchantment slots.')
      font: verdana-11px-antialised
      color: #8099b8

  // -- Source / Result row --
  Panel
    id: classPreviewRow
    height: 130
    anchors.top: classInfoPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

    // Source panel
    FlatPanel
      id: classSourcePanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 220

      Label
        id: classSourceTitle
        !text: tr('Source Item')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #a0b8cc

      Panel
        id: classItemContainer
        size: 52 52
        anchors.top: classSourceTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        ForgeItemSlot
          id: classSourceItem
          size: 48 48
          anchors.centerIn: parent

      Label
        id: classPlaceholder
        !text: tr('Drag item here')
        text-align: center
        anchors.top: classItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 3
        font: verdana-11px-antialised
        color: #40506a

      Label
        id: classSourceTierLabel
        text-align: center
        anchors.top: classPlaceholder.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 1
        font: verdana-11px-antialised
        color: #8099b8

    // Arrow
    UIWidget
      id: classArrow
      image-source: /images/ui/arrow_horizontal
      image-clip: 0 0 24 21
      size: 24 21
      anchors.verticalCenter: classSourcePanel.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter

    // Result panel
    FlatPanel
      id: classResultPanel
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 220

      Label
        id: classResultTitle
        !text: tr('Result')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #a0b8cc

      Panel
        id: classResultItemContainer
        size: 52 52
        anchors.top: classResultTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        UIItem
          id: classResultItem
          size: 48 48
          anchors.centerIn: parent
          virtual: true

      Label
        id: classResultTierLabel
        text-align: center
        anchors.top: classResultItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        font: verdana-11px-antialised
        color: #a0b8cc

      Label
        id: classResultMessage
        text-align: center
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 5
        font: verdana-11px-antialised
        color: #a0b8cc

  // -- Materials area --
  FlatPanel
    id: classActionPanel
    anchors.top: classPreviewRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6

    // Section title
    Label
      id: classMatSectionTitle
      !text: tr('Required Materials')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #c8d8e8

    // Sub-hint
    Label
      id: classMatTitle
      !text: tr('You can increase the success chance by 20%% using the bonus option.')
      text-align: center
      text-wrap: true
      height: 14
      anchors.top: classMatSectionTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 16
      margin-right: 16
      font: verdana-11px-antialised
      color: #506070

    // Materials + action row
    Panel
      id: classActionRow
      height: 136
      anchors.top: classMatTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6

      // ── Left: fragment slots ──────────────────────────────
      Panel
        id: classSlotsGroup
        width: 182
        height: 130
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 14
        margin-top: 3

        ForgeFragmentSlot
          id: classTierRuneSlot
          anchors.top: parent.top
          anchors.left: parent.left

        ForgeFragmentSlot
          id: classProtRuneSlot
          anchors.top: parent.top
          anchors.left: classTierRuneSlot.right
          margin-left: 8

      // ── Vertical separator ────────────────────────────────
      UIWidget
        id: classSlotSep
        width: 1
        background-color: #1e2d45
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: classSlotsGroup.right
        margin-left: 12
        margin-top: 6
        margin-bottom: 6

      // ── Right panel: 3 sections ───────────────────────────
      FlatPanel
        id: classRightPanel
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: classSlotSep.right
        anchors.right: parent.right
        margin-left: 10
        margin-right: 12
        margin-top: 3
        margin-bottom: 3

        // ════ SECTION 1: +20% Boost toggle ════════════════
        Panel
          id: classBonusSection
          height: 46
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          margin-left: 10
          margin-right: 10

          // +20% image button
          UIWidget
            id: classBonusButton
            size: 66 66
            image-source: /images/ui/20
            image-clip: 0 0 66 66
            image-size: 66 66
            image-color: #999999
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter

            $on:
              image-clip: 66 0 66 66
              image-color: #ffffff

            $pressed:
              image-color: #bbbbbb

          // Label group to the right of button
          Panel
            id: classBonusLabelGroup
            anchors.left: classBonusButton.right
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            margin-left: 10

            Label
              !text: tr('+20% Success Boost')
              anchors.top: parent.top
              anchors.left: parent.left
              anchors.right: parent.right
              margin-top: 2
              font: verdana-11px-antialised
              color: #7090a8

            // Bonus cost inline
            Panel
              id: classBonusCostRow
              height: 20
              anchors.top: parent.top
              anchors.left: parent.left
              anchors.right: parent.right
              margin-top: 18

              Label
                !text: tr('Extra:')
                anchors.left: parent.left
                anchors.verticalCenter: parent.verticalCenter
                font: verdana-11px-antialised
                color: #3a5070

              UIWidget
                size: 14 14
                image-source: /images/ui/crystal_coin
                image-size: 14 14
                anchors.left: parent.left
                anchors.verticalCenter: parent.verticalCenter
                margin-left: 38

              Label
                id: classBonusCostLabel
                anchors.left: parent.left
                anchors.verticalCenter: parent.verticalCenter
                margin-left: 56
                width: 60
                font: verdana-11px-antialised
                color: #c8b400

        // Separator 1
        UIWidget
          id: classSep1
          height: 1
          background-color: #1a2840
          anchors.top: classBonusSection.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          margin-left: 8
          margin-right: 8

        // ════ SECTION 2: Success Chance ═══════════════════
        Panel
          id: classChancePanel
          height: 30
          anchors.top: classSep1.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 6
          margin-left: 10
          margin-right: 10

          Label
            !text: tr('Success Chance:')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            font: verdana-11px-antialised
            color: #3a5070

          Label
            id: classChanceLabel
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            width: 60
            text-align: right
            font: verdana-11px-antialised
            color: #00dd44

        // Separator 2
        UIWidget
          id: classSep2
          height: 1
          background-color: #1a2840
          anchors.top: classChancePanel.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 6
          margin-left: 8
          margin-right: 8

        // ════ SECTION 3: Forge action ══════════════════════
        Panel
          id: classForgeRow
          anchors.top: classSep2.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin-top: 4

          // Centered unit: cost pill + forge button
          Panel
            id: classForgeCenter
            width: 256
            height: 66
            anchors.centerIn: parent

            // Cost pill
            Panel
              id: classCostPill
              width: 110
              height: 66
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              background-color: #060a10
              border-width: 1
              border-color: #1e3050

              Label
                !text: tr('Forge Cost')
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                margin-top: 7
                margin-left: 10
                font: verdana-11px-antialised
                color: #304560

              // Divider inside pill
              UIWidget
                height: 1
                background-color: #1a2840
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                margin-top: 24
                margin-left: 6
                margin-right: 6

              UIWidget
                id: classCostCoin
                size: 18 18
                image-source: /images/ui/crystal_coin
                image-size: 18 18
                anchors.left: parent.left
                anchors.bottom: parent.bottom
                margin-left: 10
                margin-bottom: 9

              Label
                id: classCostLabel
                anchors.left: classCostCoin.right
                anchors.bottom: classCostCoin.bottom
                anchors.right: parent.right
                margin-left: 4
                margin-right: 6
                height: 18
                font: verdana-11px-antialised
                color: #ffd700
                text-align: left

            // Forge button
            UIButton
              id: classForgeButton
              size: 128 66
              image-source: /images/game/imbuing/imbue_green
              image-clip: 0 0 128 66
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              enabled: false
              image-color: #80dd80

              $pressed:
                image-clip: 0 66 128 66

              $disabled:
                image-color: #304535

    // Status label
    Label
      id: classMaterialLabel
      text-align: center
      anchors.top: classActionRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 16
      margin-right: 16
      font: verdana-11px-antialised
      color: #8099b8
      text-wrap: true
      height: 16

    ProgressBar
      id: classProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 80
      margin-right: 80
      margin-bottom: 5
      height: 10
      background-color: #2255aa
      visible: false


// ============================================================
// ATTRIBUTES TAB (ENCHANTMENTS)
// ============================================================
ForgeAttributesTab < Panel
  id: attributesTab

  // -- Info banner --
  FlatPanel
    id: attrInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: attrInfoLabel
      anchors.fill: parent
      margin: 5 8 5 8
      text-wrap: true
      text-auto-resize: false
      !text: tr('Modify your item\'s attributes. Drag an item to the slot. Selecting a specific attribute costs more than a random one.')
      font: verdana-11px-antialised
      color: #8099b8

  // -- Left column: source item + enchantments list --
  FlatPanel
    id: attrItemPanel
    anchors.top: attrInfoPanel.bottom
    anchors.left: parent.left
    width: 226
    anchors.bottom: attrResultPanel.top
    margin-top: 6
    margin-bottom: 6

    Label
      id: attrItemTitle
      !text: tr('Source Item')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      font: verdana-11px-antialised
      color: #a0b8cc

    Panel
      id: attrItemContainer
      size: 52 52
      anchors.top: attrItemTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
      image-source: /images/ui/slot
      image-size: 52 52

      ForgeItemSlot
        id: attrSourceItem
        size: 48 48
        anchors.centerIn: parent

    Label
      id: attrPlaceholder
      !text: tr('Drag item here')
      text-align: center
      anchors.top: attrItemContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      font: verdana-11px-antialised
      color: #40506a

    Label
      id: attrItemInfo
      text-align: center
      anchors.top: attrPlaceholder.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      font: verdana-11px-antialised
      color: #8099b8

    Label
      id: attrEnchantTitle
      !text: tr('Current Enchantments')
      text-align: center
      anchors.top: attrItemInfo.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #c8d8e8

    UIWidget
      id: attrEnchantDivider
      height: 1
      background-color: #1e2d45
      anchors.top: attrEnchantTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 8
      margin-right: 8

    ScrollableFlatPanel
      id: attrEnchantList
      anchors.top: attrEnchantDivider.bottom
      anchors.left: parent.left
      anchors.right: attrEnchantScroll.left
      anchors.bottom: parent.bottom
      margin: 4 0 6 8
      vertical-scrollbar: attrEnchantScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: attrEnchantScroll
      anchors.top: attrEnchantDivider.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-bottom: 6
      step: 16
      pixels-scroll: true

  // -- Right column: action selector + fragment + cost --
  FlatPanel
    id: attrActionPanel
    anchors.top: attrInfoPanel.bottom
    anchors.right: parent.right
    width: 478
    anchors.bottom: attrResultPanel.top
    margin-top: 6
    margin-bottom: 6

    Label
      id: attrActionTitle
      !text: tr('Enchantment Action')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      font: verdana-11px-antialised
      color: #c8d8e8

    UIWidget
      id: attrActionDivider
      height: 1
      background-color: #1e2d45
      anchors.top: attrActionTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 8
      margin-right: 8

    Label
      id: attrActionLabel
      !text: tr('Action:')
      anchors.top: attrActionDivider.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: 12
      font: verdana-11px-antialised
      color: #8099b8

    ComboBox
      id: attrActionCombo
      anchors.top: attrActionLabel.top
      anchors.left: attrActionLabel.right
      anchors.right: parent.right
      margin-left: 8
      margin-right: 12
      margin-top: -2

    Panel
      id: attrReplacePanel
      height: 90
      anchors.top: attrActionCombo.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4

      Label
        id: attrReplaceSlotLabel
        !text: tr('Slot:')
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 12
        font: verdana-11px-antialised
        color: #8099b8
        visible: false

      ComboBox
        id: attrReplaceSlotCombo
        anchors.top: attrReplaceSlotLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 12
        margin-right: 12
        visible: false

      Label
        id: attrReplaceAttrLabel
        !text: tr('New attribute:')
        anchors.top: attrReplaceSlotCombo.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        margin-left: 12
        margin-right: 12
        font: verdana-11px-antialised
        color: #8099b8
        visible: false

      ComboBox
        id: attrReplaceAttrCombo
        anchors.top: attrReplaceAttrLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 12
        margin-right: 12
        visible: false

    // Fragment slot + cost in same row
    Panel
      id: attrMaterialRow
      height: 130
      anchors.top: attrReplacePanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4

      Label
        id: attrRuneTitle
        !text: tr('Required Fragment (x100):')
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 12
        font: verdana-11px-antialised
        color: #6680aa

      ForgeAttrSlot
        id: attrRuneSlot
        anchors.top: attrRuneTitle.bottom
        anchors.left: parent.left
        margin-top: 4
        margin-left: 12

      Panel
        id: attrCostGroup
        width: 160
        height: 60
        anchors.top: attrRuneTitle.bottom
        anchors.left: attrRuneSlot.right
        margin-left: 20
        margin-top: 10

        Label
          id: attrCostTitle
          !text: tr('Total cost:')
          anchors.top: parent.top
          anchors.left: parent.left
          font: verdana-11px-antialised
          color: #6680aa

        Panel
          id: attrCostIconRow
          height: 24
          anchors.top: attrCostTitle.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 4

          Panel
            image-source: /images/ui/crystal_coin
            image-size: 20 20
            size: 20 20
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter

          Label
            id: attrCostLabel
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 26
            width: 120
            font: verdana-11px-antialised
            color: #ffd700

      Button
        id: attrExecuteButton
        !text: tr('Apply!')
        width: 120
        anchors.top: attrRuneTitle.bottom
        anchors.right: parent.right
        margin-top: 8
        margin-right: 12
        enabled: false

    ProgressBar
      id: attrProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: attrDescPanel.top
      margin-left: 20
      margin-right: 20
      margin-bottom: 4
      height: 10
      background-color: #2255aa
      visible: false

    FlatPanel
      id: attrDescPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 4 8 8 8

      Label
        id: attrDescLabel
        anchors.fill: parent
        margin: 5
        text-wrap: true
        text-auto-resize: true
        font: verdana-11px-antialised
        color: #607090

  // -- Result bar (bottom) --
  FlatPanel
    id: attrResultPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 24

    Label
      id: attrResultMessage
      text-align: center
      anchors.fill: parent
      margin: 4
      font: verdana-11px-antialised
      color: #a0b8cc


// ============================================================
// TOOLS TAB (UPGRADE)
// ============================================================
ForgeToolsTab < Panel
  id: toolsTab

  // -- Description banner --
  FlatPanel
    id: toolsInfoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 2

    Label
      id: toolsInfoLabel
      anchors.fill: parent
      margin: 5 12 5 12
      text-wrap: true
      text-auto-resize: false
      !text: tr('Upgrade your equipment to improve its stats. Higher upgrade levels have lower success chance. Failed upgrades may downgrade the item.')
      font: verdana-11px-antialised
      color: #8099b8

  // -- Source / Result row --
  Panel
    id: toolsPreviewRow
    height: 130
    anchors.top: toolsInfoPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

    FlatPanel
      id: toolsSourcePanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 220

      Label
        id: toolsSourceTitle
        !text: tr('Source Item')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #a0b8cc

      Panel
        id: toolsItemContainer
        size: 52 52
        anchors.top: toolsSourceTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        ForgeItemSlot
          id: toolsSourceItem
          size: 48 48
          anchors.centerIn: parent

      Label
        id: toolsPlaceholder
        !text: tr('Drag item here')
        text-align: center
        anchors.top: toolsItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 3
        font: verdana-11px-antialised
        color: #40506a

      Label
        id: toolsSourceLevelLabel
        text-align: center
        anchors.top: toolsPlaceholder.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 1
        font: verdana-11px-antialised
        color: #8099b8

    UIWidget
      id: toolsArrow
      image-source: /images/ui/arrow_horizontal
      image-clip: 0 0 24 21
      size: 24 21
      anchors.verticalCenter: toolsSourcePanel.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter

    FlatPanel
      id: toolsResultPanel
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 220

      Label
        id: toolsResultTitle
        !text: tr('Result')
        text-align: center
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        font: verdana-11px-antialised
        color: #a0b8cc

      Panel
        id: toolsResultItemContainer
        size: 52 52
        anchors.top: toolsResultTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/ui/slot
        image-size: 52 52

        UIItem
          id: toolsResultItem
          size: 48 48
          anchors.centerIn: parent
          virtual: true

      Label
        id: toolsResultLevelLabel
        text-align: center
        anchors.top: toolsResultItemContainer.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        font: verdana-11px-antialised
        color: #a0b8cc

      Label
        id: toolsResultMessage
        text-align: center
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 5
        font: verdana-11px-antialised
        color: #a0b8cc

  // -- Materials area --
  FlatPanel
    id: toolsActionPanel
    anchors.top: toolsPreviewRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6

    Label
      id: toolsMatSectionTitle
      !text: tr('Required Materials')
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-antialised
      color: #c8d8e8

    Label
      id: toolsMatTitle
      !text: tr('You can increase the success chance by 20%% using the bonus option.')
      text-align: center
      text-wrap: true
      height: 14
      anchors.top: toolsMatSectionTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 16
      margin-right: 16
      font: verdana-11px-antialised
      color: #506070

    Panel
      id: toolsActionRow
      height: 136
      anchors.top: toolsMatTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6

      // ── Left: fragment slots ──────────────────────────────
      Panel
        id: toolsSlotsGroup
        width: 182
        height: 130
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 14
        margin-top: 3

        ForgeFragmentSlot
          id: toolsUpgradeRuneSlot
          anchors.top: parent.top
          anchors.left: parent.left

        ForgeFragmentSlot
          id: toolsProtRuneSlot
          anchors.top: parent.top
          anchors.left: toolsUpgradeRuneSlot.right
          margin-left: 8

      // ── Vertical separator ────────────────────────────────
      UIWidget
        id: toolsSlotSep
        width: 1
        background-color: #1e2d45
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: toolsSlotsGroup.right
        margin-left: 12
        margin-top: 6
        margin-bottom: 6

      // ── Right panel: 3 sections ───────────────────────────
      FlatPanel
        id: toolsRightPanel
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: toolsSlotSep.right
        anchors.right: parent.right
        margin-left: 10
        margin-right: 12
        margin-top: 3
        margin-bottom: 3

        // ════ SECTION 1: +20% Boost toggle ════════════════
        Panel
          id: toolsBonusSection
          height: 46
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          margin-left: 10
          margin-right: 10

          // +20% image button
          UIWidget
            id: toolsBonusButton
            size: 66 66
            image-source: /images/ui/20
            image-clip: 0 0 66 66
            image-size: 66 66
            image-color: #999999
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter

            $on:
              image-clip: 66 0 66 66
              image-color: #ffffff

            $pressed:
              image-color: #bbbbbb

          // Label group to the right of button
          Panel
            id: toolsBonusLabelGroup
            anchors.left: toolsBonusButton.right
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            margin-left: 10

            Label
              !text: tr('+20% Success Boost')
              anchors.top: parent.top
              anchors.left: parent.left
              anchors.right: parent.right
              margin-top: 2
              font: verdana-11px-antialised
              color: #7090a8

            // Bonus cost inline
            Panel
              id: toolsBonusCostRow
              height: 20
              anchors.top: parent.top
              anchors.left: parent.left
              anchors.right: parent.right
              margin-top: 18

              Label
                !text: tr('Extra:')
                anchors.left: parent.left
                anchors.verticalCenter: parent.verticalCenter
                font: verdana-11px-antialised
                color: #3a5070

              UIWidget
                size: 14 14
                image-source: /images/ui/crystal_coin
                image-size: 14 14
                anchors.left: parent.left
                anchors.verticalCenter: parent.verticalCenter
                margin-left: 38

              Label
                id: toolsBonusCostLabel
                anchors.left: parent.left
                anchors.verticalCenter: parent.verticalCenter
                margin-left: 56
                width: 60
                font: verdana-11px-antialised
                color: #c8b400

        // Separator 1
        UIWidget
          id: toolsSep1
          height: 1
          background-color: #1a2840
          anchors.top: toolsBonusSection.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          margin-left: 8
          margin-right: 8

        // ════ SECTION 2: Success Chance ═══════════════════
        Panel
          id: toolsChancePanel
          height: 30
          anchors.top: toolsSep1.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 6
          margin-left: 10
          margin-right: 10

          Label
            !text: tr('Success Chance:')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            font: verdana-11px-antialised
            color: #3a5070

          Label
            id: toolsChanceLabel
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            width: 60
            text-align: right
            font: verdana-11px-antialised
            color: #00dd44

        // Separator 2
        UIWidget
          id: toolsSep2
          height: 1
          background-color: #1a2840
          anchors.top: toolsChancePanel.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 6
          margin-left: 8
          margin-right: 8

        // ════ SECTION 3: Forge action ══════════════════════
        Panel
          id: toolsForgeRow
          anchors.top: toolsSep2.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin-top: 4

          // Centered unit: cost pill + forge button
          Panel
            id: toolsForgeCenter
            width: 256
            height: 66
            anchors.centerIn: parent

            // Cost pill
            Panel
              id: toolsCostPill
              width: 110
              height: 66
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              background-color: #060a10
              border-width: 1
              border-color: #1e3050

              Label
                !text: tr('Forge Cost')
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                margin-top: 7
                margin-left: 10
                font: verdana-11px-antialised
                color: #304560

              // Divider inside pill
              UIWidget
                height: 1
                background-color: #1a2840
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                margin-top: 24
                margin-left: 6
                margin-right: 6

              UIWidget
                id: toolsCostCoin
                size: 18 18
                image-source: /images/ui/crystal_coin
                image-size: 18 18
                anchors.left: parent.left
                anchors.bottom: parent.bottom
                margin-left: 10
                margin-bottom: 9

              Label
                id: toolsCostLabel
                anchors.left: toolsCostCoin.right
                anchors.bottom: toolsCostCoin.bottom
                anchors.right: parent.right
                margin-left: 4
                margin-right: 6
                height: 18
                font: verdana-11px-antialised
                color: #ffd700
                text-align: left

            // Forge button
            UIButton
              id: toolsForgeButton
              size: 128 66
              image-source: /images/game/imbuing/imbue_green
              image-clip: 0 0 128 66
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              enabled: false
              image-color: #80dd80

              $pressed:
                image-clip: 0 66 128 66

              $disabled:
                image-color: #304535

    Label
      id: toolsMaterialLabel
      text-align: center
      anchors.top: toolsActionRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 16
      margin-right: 16
      font: verdana-11px-antialised
      color: #8099b8
      text-wrap: true
      height: 16

    ProgressBar
      id: toolsProgressBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 80
      margin-right: 80
      margin-bottom: 5
      height: 10
      background-color: #2255aa
      visible: false


// ============================================================
// INSTANTIATE WINDOW
// ============================================================
ForgeWindow
