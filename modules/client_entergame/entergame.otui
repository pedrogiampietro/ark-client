EnterGameLabel < Label
  text-auto-resize: true
  font: verdana-11px-antialised
  color: #cccccc

EnterGameButton < Button
  size: 43 20

LoginButton < Button
  height: 28
  image-source: /images/ui/buttons-gold
  image-clip: 0 0 43 20
  image-border: 4
  color: #ffffff
  font: verdana-11px-antialised

  $hover !disabled:
    image-clip: 0 20 43 20

  $pressed:
    image-clip: 0 20 43 20
    text-offset: 1 1

LinkLabel < Label
  font: verdana-11px-antialised
  color: #888888
  text-auto-resize: true
  change-cursor-image: true
  cursor: pointer

  $hover:
    color: #c8a050

MainWindow
  id: enterGame
  !text: tr('Enter Game')
  size: 290 262
  @onEnter: EnterGame.doLogin()

  EnterGameLabel
    !text: tr('Account:')
    anchors.top: parent.top
    anchors.left: parent.left

  PasswordTextEdit
    id: accountNameTextEdit
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.top: prev.top
    margin-left: 10
    margin-right: 5

  EnterGameLabel
    !text: tr('Password:')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 13

  PasswordTextEdit
    id: accountPasswordTextEdit
    anchors.left: accountNameTextEdit.left
    anchors.right: parent.right
    anchors.top: prev.top
    margin-right: 5

  FlatPanel
    height: 22
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 13
    margin-right: 5

  CheckBox
    id: rememberPasswordBox
    !text: tr('Remember password')
    !tooltip: tr('Remember account and password when starts client')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.top
    margin: 5

  EnterGameLabel
    !text: tr('Server:')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 13

  ComboBox
    id: serverComboBox
    anchors.left: prev.right
    anchors.top: prev.top
    anchors.right: parent.right
    margin-left: 10
    margin-top: -3
    @onOptionChange: EnterGame.onServerChange()
    @onSetup: |
      for _, server in ipairs(SERVER_LIST) do
        self:addOption(server.name or server.host, server)
      end

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 13

  LoginButton
    !text: tr('Login')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 10
    margin-right: 5
    @onClick: EnterGame.doLogin()

  LinkLabel
    !text: tr('Criar conta')
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 3
    @onClick: g_platform.openUrl("https://eldera.pro/criar-conta")

  LinkLabel
    !text: tr('Cancelar')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 3
    margin-right: 5
    @onClick: EnterGame.hide()

  Label
    id: serverInfoLabel
    font: verdana-11px-rounded
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: prev.top
    margin-bottom: 3
    color: #50c050
    text-auto-resize: true
