BestiaryRaceButton < Button
  height: 20
  font: verdana-11px-monochrome
  text-align: left
  padding-left: 4

BestiaryCreatureButton < Button
  height: 20
  font: verdana-11px-monochrome
  text-align: left
  padding-left: 4

BestiaryCharmButton < Button
  height: 20
  font: verdana-11px-monochrome
  text-align: left
  padding-left: 4

BestiaryStar < UIWidget
  size: 8 8
  margin-right: 2
  background-color: #ffcc00

BestiaryEmptyStar < UIWidget
  size: 8 8
  margin-right: 2
  background-color: #3a3a3a

BestiarySectionLabel < Label
  font: verdana-11px-monochrome
  color: #777777
  height: 12
  margin-top: 8
  margin-bottom: 2

BestiaryElementRow < UIWidget
  height: 14
  margin-top: 3

  Label
    id: elemValue
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 36
    font: verdana-11px-monochrome
    color: #cccccc
    text-align: right

  Label
    id: elemName
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 72
    font: verdana-11px-monochrome
    color: #aaaaaa

  ProgressBar
    id: elemBar
    anchors.left: elemName.right
    anchors.right: elemValue.left
    anchors.verticalCenter: parent.verticalCenter
    height: 8
    margin-left: 4
    margin-right: 4
    background-color: #44aa44

BestiaryLootEntry < UIWidget
  width: 36
  height: 50

  UIItem
    id: lootIcon
    size: 32 32
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    focusable: false
    phantom: false

  Label
    id: lootRarity
    anchors.top: lootIcon.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    font: verdana-11px-monochrome
    text-align: center
    height: 14
    margin-top: 2
    color: #aaaaaa

MainWindow
  id: bestiaryWindow
  !text: tr('Bestiary')
  size: 660 500
  @onEscape: modules.game_bestiary.toggle()

  Button
    id: tabBestiary
    !text: tr('Bestiary')
    anchors.top: parent.top
    anchors.left: parent.left
    width: 80
    height: 22
    $on:
      color: #ffaf00

  Button
    id: tabCharms
    !text: tr('Charms')
    anchors.top: tabBestiary.top
    anchors.left: tabBestiary.right
    width: 80
    height: 22
    margin-left: 3
    $on:
      color: #ffaf00

  UIWidget
    id: bestiaryPanel
    anchors.top: tabBestiary.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: btnClose.top
    margin-top: 4
    margin-bottom: 4

    TextList
      id: raceList
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 115
      vertical-scrollbar: raceScrollBar
      focusable: false
      padding: 2

    VerticalScrollBar
      id: raceScrollBar
      anchors.top: raceList.top
      anchors.bottom: raceList.bottom
      anchors.right: raceList.right
      step: 14
      pixels-scroll: true

    TextList
      id: creatureList
      anchors.top: parent.top
      anchors.left: raceList.right
      anchors.bottom: parent.bottom
      width: 145
      margin-left: 4
      vertical-scrollbar: creatureScrollBar
      focusable: false
      padding: 2

    VerticalScrollBar
      id: creatureScrollBar
      anchors.top: creatureList.top
      anchors.bottom: creatureList.bottom
      anchors.right: creatureList.right
      step: 14
      pixels-scroll: true

    VerticalScrollBar
      id: detailScrollBar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 20
      pixels-scroll: true

    ScrollablePanel
      id: creatureDetail
      anchors.top: parent.top
      anchors.left: creatureList.right
      anchors.right: detailScrollBar.left
      anchors.bottom: parent.bottom
      margin-left: 6
      padding: 6
      vertical-scrollbar: detailScrollBar
      layout: verticalBox

      UIWidget
        id: detailHeaderRow
        height: 84

        UIWidget
          id: creatureSpriteBox
          anchors.top: parent.top
          anchors.left: parent.left
          width: 78
          height: 78
          background-color: #0d0d0d
          border-width: 1
          border-color: #555555

          UICreature
            id: creatureSprite
            anchors.fill: parent
            phantom: true
            outfit-center: true
            old-scaling: true

        Label
          id: detailName
          anchors.top: parent.top
          anchors.left: creatureSpriteBox.right
          anchors.right: parent.right
          font: verdana-11px-monochrome
          color: #ffaf00
          text-align: center
          height: 20
          margin-left: 6

        UIWidget
          id: detailStarsRow
          anchors.top: detailName.bottom
          anchors.horizontalCenter: detailName.horizontalCenter
          width: 52
          height: 10
          margin-top: 4
          layout: horizontalBox

        Label
          id: detailClass
          anchors.top: detailStarsRow.bottom
          anchors.left: creatureSpriteBox.right
          anchors.right: parent.right
          font: verdana-11px-monochrome
          color: #999999
          text-align: center
          height: 14
          margin-left: 6
          margin-top: 4

        Label
          id: detailOccurrence
          anchors.top: detailClass.bottom
          anchors.left: creatureSpriteBox.right
          anchors.right: parent.right
          font: verdana-11px-monochrome
          color: #88ccff
          text-align: center
          height: 14
          margin-left: 6
          margin-top: 2

      HorizontalSeparator
        height: 2
        margin-top: 4
        margin-bottom: 2

      UIWidget
        id: detailKillSection
        height: 36

        Label
          id: detailKillsLabel
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          font: verdana-11px-monochrome
          color: #dddddd
          height: 16

        ProgressBar
          id: killProgressBar
          anchors.top: detailKillsLabel.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 8
          margin-top: 4
          background-color: #c8a050

      BestiarySectionLabel
        id: statsTitle
        text: STATS

      Label
        id: detailStats
        font: verdana-11px-monochrome
        height: 28
        text-wrap: true
        color: #cccccc

      Label
        id: detailStageHint
        font: verdana-11px-monochrome
        color: #666666
        height: 14
        text-align: center
        margin-top: 2
        margin-bottom: 2

      Label
        id: detailCharmPts
        font: verdana-11px-monochrome
        color: #ffcc44
        height: 14
        text-align: center
        margin-top: 2
        margin-bottom: 4

      BestiarySectionLabel
        id: elementsTitle
        text: RESISTANCES

      UIWidget
        id: elementsPanel
        height: 0
        margin-top: 2
        margin-bottom: 2
        layout: verticalBox

      BestiarySectionLabel
        id: lootTitle
        text: LOOT
        margin-top: 8

      UIWidget
        id: lootPanel
        height: 50
        margin-top: 4
        margin-bottom: 4
        layout:
          type: grid
          cell-size: 38 50
          flow: true

      Label
        id: detailLocations
        font: verdana-11px-monochrome
        color: #88bb88
        height: 28
        margin-top: 4
        margin-bottom: 6
        text-wrap: true

      Button
        id: trackerBtn
        !text: tr('Track')
        width: 64
        height: 18

  UIWidget
    id: charmsPanel
    anchors.top: tabBestiary.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: btnClose.top
    margin-top: 4
    margin-bottom: 4

    Label
      id: charmPointsLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-monochrome
      color: #ffaf00
      text-align: center
      height: 18

    Label
      id: charmInfoLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-monochrome
      color: #aaaaaa
      text-align: center
      height: 16
      margin-top: 2

    TextList
      id: charmList
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 5
      vertical-scrollbar: charmScrollBar
      focusable: false
      padding: 2

    VerticalScrollBar
      id: charmScrollBar
      anchors.top: charmList.top
      anchors.bottom: charmList.bottom
      anchors.right: charmList.right
      step: 14
      pixels-scroll: true

  Button
    id: btnClose
    !text: tr('Close')
    width: 64
    height: 22
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: modules.game_bestiary.toggle()
