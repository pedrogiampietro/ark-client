NonClosableMiniWindow
  height: 50
  id: sideButtonsWindow
  @onClose: modules.game_inventory.onMiniWindowClose()
  &save: true
  &autoOpen: 4

  NonClosableMiniWindowContents
    margin-left: 8

    UIButton
      id: storeButton
      anchors.left: parent.left
      anchors.top: parent.top
      width: 108
      height: 20
      image-source: /images/ui/store_large
      image-clip: 0 0 108 20
      image-border: 0
      image-smooth: true
      $hover:
        image-clip: 0 0 108 20
      $pressed:
        image-clip: 0 20 108 20
      @onClick: modules.game_store.toggle()

    RelicBoxButton
      anchors.left: storeButton.right
      anchors.top: storeButton.top
      width: 44
      margin-left: 4

    InventoryButton
      id: skillsButton
      !text: tr('Skills')
      anchors.left: parent.left
      anchors.top: prev.bottom
      margin-top: 5
      width: 34
      height: 20
      @onClick: modules.game_skills.toggle()
    
    InventoryButton
      id: battleButton
      !text: tr('Battle')
      anchors.left: prev.right
      anchors.top: prev.top
      margin-left: 4
      margin-top: 0
      width: 34
      height: 20
      @onClick: modules.game_battle.toggle()

    InventoryButton
      id: vipButton
      !text: tr('VIP')
      anchors.left: prev.right
      anchors.top: prev.top
      margin-left: 4
      margin-top: 0
      height: 20
      width: 34
      @onClick: modules.game_viplist.toggle()
    
    InventoryButton
      !text: tr('Logout')
      anchors.left: prev.left
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 9
      width: 42
      height: 20
      margin-top: 0
      @onClick: modules.game_interface.tryLogout()
