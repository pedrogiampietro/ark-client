ProgressBackground < UIWidget
  image-source: /images/ui/panel_flat
  image-border: 5
  padding: 1
  UIWidget
    background-color: #1a1a1a
    anchors.fill: parent
    phantom: true

BorderBox < UIWidget
  border-width: 1
  border-color: #555555

SubPanel < UIWidget
  image-source: /game_cyclopedia/images/bestiary/bestiaryContainer
  image-border: 3
  image-border-top: 22
  color: #929292
  text-offset: 0 3
  text-align: top

BestiaryCategory < UIWidget
  image-source: /images/ui/minipanel
  image-border: 3
  focusable: false
  $pressed:
    image-color: #bbbbbb
  Label
    id: NameLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 14
    margin-top: 4
    text-align: center
    font: verdana-11px-rounded
    color: #d0d0d0
  UIWidget
    id: ClassBase
    anchors.top: NameLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    size: 52 52
    phantom: false
    focusable: false
    $hover:
      image-color: #dddddd
    $pressed:
      image-color: #aaaaaa
  UIWidget
    id: ClassIcon
    anchors.centerIn: ClassBase
    size: 48 48
    phantom: true
  Label
    id: TotalValue
    anchors.top: ClassBase.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    font: verdana-9px-bold
    !text: 'Total: 0'
    color: #888888
  Label
    id: KnownValue
    anchors.top: TotalValue.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 1
    font: verdana-9px-bold
    !text: 'Known: 0'
    color: #888888

BestiaryCreature < UIWidget
  image-source: /images/ui/minipanel
  image-border: 3
  focusable: false
  Label
    id: Name
    height: 14
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text-align: center
    font: verdana-11px-rounded
    color: #d0d0d0
  UIWidget
    id: ClassBase
    anchors.top: Name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    size: 64 64
    phantom: false
    focusable: false
    border-width: 0
    $hover:
      border-width: 1
      border-color: #8a7a60
    $pressed:
      border-width: 1
      border-color: #c8a870
  UICreature
    id: Sprite
    anchors.centerIn: ClassBase
    size: 64 64
    phantom: true
  UIWidget
    id: AnimusMastery
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 3
    margin-right: 3
    image-source: /game_cyclopedia/images/indicator_soulcore
    visible: false
  UIWidget
    id: Finalized
    anchors.centerIn: ClassBase
    size: 16 16
    image-source: /game_cyclopedia/images/bestiary/creatureCheck
    visible: false
  Label
    id: KillsLabel
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 4
    font: verdana-11px-rounded
    text-auto-resize: true
    !text: '?'
    color: #888888

BestiaryResistProgress < UIWidget
  size: 90 14
  background-color: #1a1a1a
  border-width: 1
  border-color: #444444
  UIWidget
    id: Fill
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    background-color: #335533
    margin: 1
    phantom: true
  Label
    id: ValueLabel
    anchors.centerIn: parent
    font: verdana-11px-rounded
    text-auto-resize: true
    color: #dddddd
    phantom: true
    !text: '?'

BestiaryItem < UIItem
  image-source: /images/ui/item
  image-border: 10
  size: 34 34
  anchors.verticalCenter: parent.verticalCenter
  padding: 1
  $checked:
    image-source: /images/ui/panel_flat
  $first:
    anchors.left: parent.left
  $!first:
    anchors.left: prev.right
    margin-left: 2
  UIWidget
    id: undefinedItem
    image-source: /images/ui/item
    anchors.fill: parent
    visible: false
  Label
    id: Stackable
    text-auto-resize: true
    font: verdana-11px-rounded
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    color: #BFBFBF
    margin-bottom: -1
  UIWidget
    id: Rarity
    image-border: 5
    padding: 1
    anchors.fill: parent

BestiaryItemGroup < UIWidget
  height: 45
  UIWidget
    id: Items
    anchors.fill: parent
    margin-left: 108
  Label
    id: Title
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    !text: tr('Common') .. ':'
    text-auto-resize: true

CharmCreatureName < UIWidget
  color: #C0C0C0
  background-color: #484848
  focusable: false

CharmItem < UIWidget
  image-source: /images/ui/minipanel
  image-border: 3
  image-border-top: 14
  color: #c8c8c8
  text-offset: 0 2
  text-align: top
  font: verdana-11px-rounded
  focusable: false
  border-width: 0
  BorderBox
    id: charmBase
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 16
    size: 52 52
    image-source: /images/ui/panel_flat
    image-border: 10
    phantom: true
    UIWidget
      size: 32 32
      id: image
      anchors.centerIn: parent
      phantom: true
    UIWidget
      id: lockedMask
      size: 50 50
      anchors.centerIn: parent
      image-source: /images/options/ditherpattern
      phantom: true
  UIWidget
    id: PriceBase
    size: 80 20
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 5
    image-source: /images/ui/item
    image-border: 10
    phantom: true
    Label
      id: Value
      anchors.centerIn: parent
      !text: tr('0')
      text-auto-resize: true
      margin-right: 3
    UIWidget
      id: Charm
      anchors.left: Value.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      image-source: /game_cyclopedia/images/icon_charms
    UIWidget
      id: Gold
      anchors.left: Value.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      image-source: /game_cyclopedia/images/icon_gold
      visible: false

TrackerButton < Panel
  height: 34
  margin-bottom: 5
  phantom: false
  border-width: 1
  border-color: alpha
  padding: 1
  $hover:
    border-color: white
  UICreature
    id: creature
    size: 16 16
    anchors.left: parent.left
    anchors.top: parent.top
    phantom: true
  UIWidget
    id: spacer
    width: 3
    anchors.left: creature.right
    anchors.top: creature.top
  Label
    id: label
    anchors.left: spacer.right
    anchors.top: creature.top
    text-auto-resize: true
    color: #888888
    margin-left: 2
  Label
    id: kills
    anchors.right: parent.right
    anchors.top: creature.top
    text-align: right
    text-auto-resize: true
    color: #888888
    margin-left: 2
  ProgressBackground
    id: ProgressBorder2
    anchors.left: spacer.right
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: creature.bottom
    margin-top: 2
    size: 54 15
  ProgressBackground
    id: ProgressBorder1
    anchors.right: ProgressBorder2.left
    anchors.top: creature.bottom
    margin-right: 2
    margin-top: 2
    size: 54 15
  ProgressBackground
    id: ProgressBorder3
    anchors.left: ProgressBorder2.right
    anchors.top: creature.bottom
    margin-top: 2
    margin-left: 2
    size: 54 15
  UIWidget
    id: killsBar2
    anchors.left: ProgressBorder1.left
    anchors.top: creature.bottom
    height: 12
    phantom: true
    margin-top: 3
  UIWidget
    id: ProgressBack33
    anchors.left: ProgressBorder2.left
    anchors.top: creature.bottom
    height: 12
    phantom: true
    margin-top: 3
  UIWidget
    id: ProgressBack55
    anchors.left: ProgressBorder3.left
    anchors.top: creature.bottom
    height: 12
    phantom: true
    margin-top: 3

CharmProcRow < UIWidget
  height: 22
  layout:
    type: horizontalBox
    spacing: 4
  UIWidget
    id: icon
    size: 20 20
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
  Label
    id: charmName
    color: #C0C0C0
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
  Label
    id: procCount
    color: #e0c060
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
  Label
    id: totalDmg
    color: #a0a0ff
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true

BestiaryTracker < MiniWindow
  id: BestiaryTracker
  !text: tr('Bestiary Tracker')
  @onClose: modules.game_cyclopedia.onTrackerClose()
  MiniWindowContents
    layout: verticalBox
    padding-left: 5
    padding-right: 5
    padding-top: 3
    padding-bottom: 3

    UIWidget
      id: trackerTabBar
      height: 20
      layout:
        type: horizontalBox
        spacing: 3
      UIButton
        id: tabBestiary
        !text: tr('Bestiary')
        height: 20
        flex: 1
        color: #C0C0C0
        $on:
          color: #ffffff
        @onClick: modules.game_cyclopedia.Cyclopedia.showTrackerTab('bestiary')
      UIButton
        id: tabCharms
        !text: tr('Charms')
        height: 20
        flex: 1
        color: #C0C0C0
        $on:
          color: #ffffff
        @onClick: modules.game_cyclopedia.Cyclopedia.showTrackerTab('charms')

    UIWidget
      id: contentsPanel
      layout: verticalBox
      padding-top: 3

    UIWidget
      id: charmAnalyzerPanel
      layout: verticalBox
      padding-top: 3
      visible: false

      UIWidget
        id: analyzerHeader
        height: 18
        layout:
          type: horizontalBox
          spacing: 4
        Label
          id: sessionLabel
          color: #C0C0C0
          text: 'Session: 00:00'
          text-auto-resize: true
        UIButton
          id: resetButton
          !text: tr('Reset')
          height: 16
          width: 40
          margin-left: 4
          @onClick: modules.game_cyclopedia.Cyclopedia.resetCharmAnalyzer()

      UIWidget
        id: analyzerList
        layout: verticalBox
        spacing: 2
